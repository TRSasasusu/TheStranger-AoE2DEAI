(defconst gl-resource-camps-local-total 190)
(defconst gl-resource-camps-local-last 191)
(defconst gl-resource-camps-remote-total 192)
(defconst gl-resource-camps-remote-last 193)
(defconst gl-resource-found-local-total 194)
(defconst gl-resource-found-local-last 195)
(defconst gl-resource-found-remote-total 196)
(defconst gl-resource-found-remote-last 197)
(defconst gl-resource-type 198)
(defconst gl-resource-camps 199)
(defconst gl-resource-percentage 200)
(defconst gl-resource-status 201)
;(defconst gl-resource-lumber-camp-appear 202)
;(defconst gl-resource-mining-camp-appear 203)



(defrule
    (game-time > 1200)
    =>
    (set-strategic-number sn-camp-max-distance 30)
    (disable-self)
)
(defrule
    (game-time > 1800)
    =>
    (set-strategic-number sn-camp-max-distance 80)
    (disable-self)
)
(defrule
    (game-time > 2400)
    =>
    (set-strategic-number sn-camp-max-distance 200)
    (disable-self)
)




(defrule
    (true)
    =>
    (set-goal gl-resource-type wood)
    (set-goal gl-resource-camps lumber-camp)
    (up-modify-goal gl-resource-percentage s:= sn-wood-gatherer-percentage)
    (set-goal gl-resource-camps-local-total -1)
    (set-goal gl-resource-status status-ready)
    ;(chat-to-all "lumbercamp!")
)
(defrule
    (up-compare-goal gl-resource-percentage > 0)
    =>
    (up-full-reset-search)
    (up-filter-status g: gl-resource-status c: list-active)
    (up-find-resource g: gl-resource-type c: 30)
    (up-get-search-state gl-resource-found-local-total)
)
(defrule
    (up-compare-goal gl-resource-percentage > 0)
    (up-compare-goal gl-resource-found-remote-total == 0)
    =>
    (chat-to-all "no resource")
    (up-jump-rule 5)
)
(defrule
    ;(up-object-type-count-total g: gl-resource-camps > 0)
    (up-compare-goal gl-resource-percentage > 0)
    =>
    (up-full-reset-search)
    ;(up-filter-status c: status-ready c: list-active)
    (up-find-local g: gl-resource-camps c: 20)
    (up-filter-status c: status-pending c: list-active)
    (up-find-status-local g: gl-resource-camps c: 20)
    (up-get-search-state gl-resource-camps-local-total)
)
(defrule
    ;(up-object-type-count-total g: gl-resource-camps > 0)
    (up-compare-goal gl-resource-percentage > 0)
    (up-compare-goal gl-resource-camps-local-total > 0)
    =>
    (up-modify-goal gl-resource-camps-local-total c:- 1)
    (up-set-target-object search-local g: gl-resource-camps-local-total)
    (up-get-point position-object gl-tmp-x)
    (up-set-target-point gl-tmp-x)
    ;(up-send-flare gl-tmp-x)
    (up-reset-filters)
    (up-reset-search 0 0 1 1)
    (up-filter-status g: gl-resource-status c: list-active)
    (up-filter-distance c: -1 c: 5)
    (up-find-resource g: gl-resource-type c: 30)
    (up-get-search-state gl-resource-found-local-total)
    ;(up-chat-data-to-all "number of res: %d" g: gl-resource-found-remote-total)
)
(defrule
    ;(up-object-type-count-total g: gl-resource-camps > 0)
    (up-compare-goal gl-resource-percentage > 0)
    (up-compare-goal gl-resource-found-remote-total > 0)
    =>
    (up-jump-rule 2)
)
(defrule
    ;(up-object-type-count-total g: gl-resource-camps > 0)
    (up-compare-goal gl-resource-percentage > 0)
    (up-compare-goal gl-resource-camps-local-total > 0)
    (up-compare-goal gl-resource-found-remote-total == 0)
    =>
    ;(do-nothing)
    (up-jump-rule -3)
)
(defrule
    ;(up-object-type-count-total g: gl-resource-camps > 0)
    (up-compare-goal gl-resource-percentage > 0)
    (goal gl-resource-camps-local-total 0)
    (up-can-build 0 g: gl-resource-camps)
    =>
    (up-build place-normal 0 g: gl-resource-camps)
)

(defrule
    (goal gl-resource-type wood)
    =>
    (set-goal gl-resource-type gold)
    (set-goal gl-resource-camps mining-camp)
    (set-goal gl-resource-camps-local-total -1)
    (up-modify-goal gl-resource-percentage s:= sn-gold-gatherer-percentage)
    (set-goal gl-resource-status status-resource)
    (up-jump-rule -8)
)
(defrule
    (goal gl-resource-type gold)
    =>
    (set-goal gl-resource-type stone)
    (set-goal gl-resource-camps-local-total -1)
    (up-modify-goal gl-resource-percentage s:= sn-stone-gatherer-percentage)
    (up-jump-rule -9)
)