(defconst gl-trade-market 220)

(defrule
    (true)
    =>
    (set-goal gl-trade-market 0)
    (set-goal gl-trade-stop 0)
    (disable-self)
)

(defrule
    (goal gl-trade-stop 0)
    (player-in-game any-ally)
    (game-time > 1500)
    (current-age >= castle-age)
    (goal gl-trade-market 0)
    (can-build market)
    =>
    (delete-building market)
    (up-set-placement-data my-player-number -1 c: -40)
    (up-build place-control 0 c: market)
    (set-goal gl-trade-market 1)
)

(defrule
    (goal gl-trade-stop 0)
    (player-in-game any-ally)
    (game-time > 1500)
    (current-age >= castle-age)
    (can-research ri-caravan)
    (unit-type-count-total trade-cart > 2)
    =>
    (research ri-caravan)
)

(defrule
    (goal gl-trade-stop 0)
    (player-in-game any-ally)
    (game-time > 1500)
    (current-age >= castle-age)
    (can-train trade-cart)
    (unit-type-count-total trade-cart < 20)
    =>
    (train trade-cart)
)