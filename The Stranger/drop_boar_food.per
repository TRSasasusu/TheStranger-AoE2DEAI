(defconst t-drop-boar-food-timer 29)

(defrule
    (up-timer-status t-drop-boar-food-timer != timer-running)
    (current-age == dark-age)
    (goal gl-researching-feudal 0)
    (food-amount < 50)
    (housing-headroom > 0)
    =>
    (up-drop-resources food c: 1)
    (up-drop-resources hunting c: 1)
    (enable-timer t-drop-boar-food-timer 5)
)