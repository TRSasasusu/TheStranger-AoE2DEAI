(defrule
    (can-build castle)
    =>
    (up-assign-builders c: castle c: 10)
    (build castle)
)

(defrule
    (current-age == imperial-age)
    (can-train archer-line)
    =>
    (train archer-line)
)

(defrule
    (current-age == imperial-age)
    (can-train trebuchet)
    (up-object-type-count c: archer-line >= 10)
    (or
        (research-completed ri-ballistics)
        (unit-type-count trebuchet <= 2)
    )
    =>
    (train trebuchet)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
)

(defrule
    (current-age == imperial-age)
    (can-train bombard-cannon-line)
    (up-object-type-count c: archer-line >= 10)
    (or
        (research-completed ri-ballistics)
        (unit-type-count bombard-cannon-line <= 2)
    )
    =>
    (train bombard-cannon-line)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
)