; build gate
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 0)
    (goal gl-wall-building-pending 0)
    (up-compare-goal gl-wall-building-range != 0)
    =>
    (set-goal gl-wall-building-range 0)
    (set-goal gl-wall-building-pending 1)
    (up-modify-goal gl-wall-building-criterion g:= gl-wall-building-criterion-initial)
    (chat-to-all "building range set to 0 for gate")
)
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 0)
    (goal gl-wall-gate-type-decided 0)
    (goal gl-wall-building-pending 0)
    (up-compare-goal gl-wall-building-range == 0)
    =>
    (set-goal gl-wall-building-pending 1)
    (up-copy-point gl-wall-gate-pos-x gl-wall-building-pos-x)
    (set-goal gl-wall-gate-decided 1)
    (up-send-flare gl-wall-gate-pos-x)
    (chat-to-all "gate position decided")
)
(defrule ; shift to palisade-wall position
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)
    =>
    (up-full-reset-search)
    (up-set-target-point gl-wall-gate-pos-x)
    (up-filter-distance c: -1 c: 3)
    (up-find-local c: palisade-wall c: 10)
    (up-filter-status c: status-pending c: list-active) ; including only base
    (up-find-status-local c: palisade-wall c: 10)
    (up-get-search-state gl-tmp-local-total)
)
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)

    (up-compare-goal gl-tmp-local-total > 0)
    =>
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object gl-wall-gate-pos-x)
    (chat-to-all "gate position finally decided")
    (up-send-flare gl-wall-gate-pos-x)
)

(defrule ; is ascending?
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)
    =>
    (up-copy-point gl-tmp-x gl-wall-gate-pos-x)
    (up-modify-goal gl-tmp-x c:+ 1)
)
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)

    ;(up-point-explored gl-wall-gate-pos-x == explored-yes)
    (up-point-contains gl-wall-gate-pos-x c: palisade-wall)
    ;(up-point-explored gl-tmp-x == explored-yes)
    (up-point-contains gl-tmp-x c: palisade-wall)
    =>
    (set-goal gl-wall-gate-type-decided 1)
    (set-goal gl-wall-gate-type0 789)
    (set-goal gl-wall-gate-type1 790)
    (set-goal gl-wall-gate-type2 791)
    (set-goal gl-wall-gate-type3 792)
    ;(up-modify-goal gl-wall-gate-pos-y c:+ 2)
    (chat-to-all "gate is ascending")
)
(defrule ; is descending?
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)
    =>
    (up-copy-point gl-tmp-x gl-wall-gate-pos-x)
    (up-modify-goal gl-tmp-y c:+ 1)
)
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)

    ;(up-point-explored gl-wall-gate-pos-x == explored-yes)
    (up-point-contains gl-wall-gate-pos-x c: palisade-wall)
    ;(up-point-explored gl-tmp-x == explored-yes)
    (up-point-contains gl-tmp-x c: palisade-wall)
    =>
    (set-goal gl-wall-gate-type-decided 1)
    (set-goal gl-wall-gate-type0 793)
    (set-goal gl-wall-gate-type1 794)
    (set-goal gl-wall-gate-type2 795)
    (set-goal gl-wall-gate-type3 796)
    ;(up-modify-goal gl-wall-gate-pos-x c:- 2)
    (chat-to-all "gate is descending")
)
(defrule ; is horizontal?
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)
    =>
    (up-copy-point gl-tmp-x gl-wall-gate-pos-x)
    (up-modify-goal gl-tmp-x c:+ 1)
    (up-modify-goal gl-tmp-y c:+ 1)
)
(defrule
    (goal gl-wall-calculated 1)
    (goal gl-wall-start-walling 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-gate-decided 1)
    (goal gl-wall-gate-type-decided 0)

    ;(up-point-explored gl-wall-gate-pos-x == explored-yes)
    (up-point-contains gl-wall-gate-pos-x c: palisade-wall)
    ;(up-point-explored gl-tmp-x == explored-yes)
    (up-point-contains gl-tmp-x c: palisade-wall)
    =>
