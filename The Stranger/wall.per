(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-x <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-south-west-not-used 1)
    (set-goal gl-wall-west-pos-x 0)
    (set-goal gl-wall-south-pos-x 0)
)
; north west corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-modify-goal gl-tmp-y g:= gl-wall-tc-pos-y)
    (up-modify-goal gl-tmp-y g:- gl-wall-distance-to-edge)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-y <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-north-west-not-used 1)
    (set-goal gl-wall-north-pos-y 0)
    (set-goal gl-wall-west-pos-y 0)
