(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-y <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-south-east-not-used 1)
    (up-modify-goal gl-wall-south-pos-y g:= gl-wall-right-corner-pos-y)
    (up-modify-goal gl-wall-east-pos-y g:= gl-wall-right-corner-pos-y)
    ;(chat-to-all "south-east corner detected")
)

; set building criterion and directions
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-tmp-x gl-wall-right-corner-pos-x)
    (up-modify-goal gl-tmp-x c:/ 2)
    (up-modify-goal gl-tmp-y c:/ 2)
    ;(up-send-flare gl-tmp-x)
    (up-add-point gl-tmp-x gl-wall-tc-pos-x c: -1)
    ;(up-chat-data-to-all "gl-tmp-x: %d" g: gl-tmp-x)
    ;(up-chat-data-to-all "gl-tmp-y: %d" g: gl-tmp-y)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x >= 20)
    (up-compare-goal gl-tmp-y >= 20)
    =>
    (set-goal gl-wall-building-criterion wall-north-east)
    (set-goal gl-wall-building-direction 1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x > -20)
    (up-compare-goal gl-tmp-x < 20)
    (up-compare-goal gl-tmp-y >= 20)
    =>
    (set-goal gl-wall-building-criterion wall-east)
    (set-goal gl-wall-building-direction 1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x <= -20)
    (up-compare-goal gl-tmp-y >= 20)
    =>
    (set-goal gl-wall-building-criterion wall-south-east)
    (set-goal gl-wall-building-direction 1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x <= -20)
    (up-compare-goal gl-tmp-y > -20)
    (up-compare-goal gl-tmp-y < 20)
    =>
    (set-goal gl-wall-building-criterion wall-south)
    (set-goal gl-wall-building-direction 1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x <= -20)
    (up-compare-goal gl-tmp-y <= -20)
    =>
    (set-goal gl-wall-building-criterion wall-south-west)
    (set-goal gl-wall-building-direction 1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x < 20)
    (up-compare-goal gl-tmp-x > -20)
    (up-compare-goal gl-tmp-y <= -20)
    =>
    (set-goal gl-wall-building-criterion wall-north)
    (set-goal gl-wall-building-direction -1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x >= 20)
    (up-compare-goal gl-tmp-y <= -20)
    =>
    (set-goal gl-wall-building-criterion wall-north)
    (set-goal gl-wall-building-direction -1)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (up-compare-goal gl-tmp-x >= 20)
    (up-compare-goal gl-tmp-y < 20)
    (up-compare-goal gl-tmp-y > -20)
    =>
    (set-goal gl-wall-building-criterion wall-north)
    (set-goal gl-wall-building-direction 1)
)
