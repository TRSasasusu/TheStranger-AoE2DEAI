    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-x <= 0)
    (up-compare-goal gl-tmp-y <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-east-not-used 1)
    (up-modify-goal gl-wall-north-east-pos-x g:= gl-wall-right-corner-pos-x)
    (up-modify-goal gl-wall-south-east-pos-y g:= gl-wall-right-corner-pos-y)
)
; south west corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-modify-goal gl-tmp-x g:= gl-wall-tc-pos-x)
    (up-modify-goal gl-tmp-x g:- gl-wall-distance-to-edge)
