(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-north-has-tree 1)
    (goal gl-wall-north-east-has-tree 0)
    (goal gl-wall-east-has-tree 1)
    =>
    (up-copy-point gl-wall-north-east-pos-x gl-wall-north-pos-x)
    (up-add-point gl-wall-north-east-pos-x gl-wall-east-pos-x c: 1)
    (up-modify-goal gl-wall-north-east-pos-x c:/ 2)
    (up-modify-goal gl-wall-north-east-pos-y c:/ 2)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-north-east-has-tree 1)
    (goal gl-wall-east-has-tree 0)
    (goal gl-wall-south-east-has-tree 1)
    =>
    (up-copy-point gl-wall-east-pos-x gl-wall-north-east-pos-x)
    (up-add-point gl-wall-east-pos-x gl-wall-south-east-pos-x c: 1)
    (up-modify-goal gl-wall-east-pos-x c:/ 2)
    (up-modify-goal gl-wall-east-pos-y c:/ 2)
    (chat-to-all "east tree position recalculated!")
)
