(defrule
    (goal gl-wall-calculated 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)

    (goal gl-wall-north-not-used 0)
    (goal gl-wall-north-east-not-used 0)

    (wood-amount > 200)
    =>
    (set-strategic-number sn-placement-zone-size 0)
    (up-build-line gl-wall-north-pos-x gl-wall-north-east-pos-x c: palisade-wall)
)
