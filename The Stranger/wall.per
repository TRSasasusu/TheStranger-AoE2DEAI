(defconst gl-wall-north-has-tree 400)
(defconst gl-wall-north-east-has-tree 401)
(defconst gl-wall-east-has-tree 402)
(defconst gl-wall-south-east-has-tree 403)
(defconst gl-wall-south-has-tree 404)
(defconst gl-wall-south-west-has-tree 405)
(defconst gl-wall-west-has-tree 406)
(defconst gl-wall-north-west-has-tree 407)
(defconst gl-wall-north-pos-x 408)
(defconst gl-wall-north-pos-y 409)
(defconst gl-wall-north-east-pos-x 410)
(defconst gl-wall-north-east-pos-y 411)
(defconst gl-wall-east-pos-x 412)
(defconst gl-wall-east-pos-y 413)
(defconst gl-wall-south-east-pos-x 414)
(defconst gl-wall-south-east-pos-y 415)
(defconst gl-wall-south-pos-x 416)
(defconst gl-wall-south-pos-y 417)
