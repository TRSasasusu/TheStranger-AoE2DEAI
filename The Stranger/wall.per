            (up-modify-goal gl-wall-building-lerp-left-distance g:min gl-tmp)
        )

        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)
            =>
            ;(up-lerp-tiles gl-tmp-x gl-tmp2-x g: gl-wall-building-tile-from-criterion)
            (up-lerp-tiles gl-tmp-x gl-tmp2-x c: 1)
            (up-modify-goal gl-wall-building-tile-from-criterion c:+ 1)
            (up-send-flare gl-tmp-x)
        )

        (defrule ; calculate the distance after lerp
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)
            =>
            (up-get-point-distance gl-tmp-x gl-tmp2-x gl-tmp)
            (up-modify-goal gl-tmp g:- gl-wall-building-lerp-left-distance)
            ;(up-chat-data-to-all "gl-wall-building-lerp-left-distance: %d" g: gl-wall-building-lerp-left-distance)
        )
        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-tmp > 0) ; lerp over the end point, we need to stop
            =>
            (set-goal gl-wall-building-tile-from-criterion-for-end 1)
            (chat-to-all "lerp reached the end point, stopping")
        )
        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)
            =>
            (up-modify-goal gl-tmp g:= gl-tmp-x)
            (up-modify-goal gl-tmp g:- gl-tmp2-x)
            (up-modify-goal gl-tmp2 g:= gl-tmp-y)
            (up-modify-goal gl-tmp2 g:- gl-tmp2-y)
        )
        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-tmp == 0)
            (up-compare-goal gl-tmp2 == 0)
            =>
            (set-goal gl-wall-building-tile-from-criterion-for-end 1)
            (chat-to-all "same point found! lerp reached the end point, stopping")
        )
        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-wall-building-tile-from-criterion > 100) ; what causes this? just in case, stop it to avoid infinite loop
            =>
            (set-goal gl-wall-building-tile-from-criterion-for-end 1)
            (chat-to-all "too many iterations, stopping")
        )

        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-point-explored gl-tmp-x == explored-yes)
            (or
                (up-get-point-contains gl-tmp-x gl-tmp c: building-class)
                (up-get-point-contains gl-tmp-x gl-tmp c: tree-class)
            )
            (up-compare-goal gl-wall-building-range > 0) ; to avoid setting gate
            =>
            ;(up-modify-goal gl-wall-building-tile-from-criterion c:+ 1)
            (chat-to-all "has building or tree, skip")
            (up-jump-direct g: gl-wall-building-tile-from-criterion-for-id); continue
        )

        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-wall-building-range > 0) ; to avoid setting gate
            =>
            (up-set-target-point gl-tmp-x)
            (up-full-reset-search)
            (up-filter-distance c: -1 g: gl-wall-building-range)
            (up-find-local c: building-class c: 20)
            (up-get-search-state gl-tmp-local-total)
        )
        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-wall-building-range > 0) ; to avoid setting gate
            (up-compare-goal gl-tmp-local-total > 0)
            =>
            ;(up-modify-goal gl-wall-building-tile-from-criterion c:+ 1)
            (chat-to-all "has building around this point, skip")
            (up-jump-direct g: gl-wall-building-tile-from-criterion-for-id); continue
        )

        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)
            =>
            (up-set-target-point gl-tmp-x)
            (up-full-reset-search)
            (up-filter-status c: status-ready c: list-active); not chopped tree
            (up-modify-goal gl-tmp g:= gl-wall-building-range)
            (up-modify-goal gl-tmp c:- 2)
            (up-filter-distance c: -1 g: gl-tmp) ; resource have less space
            (up-find-resource c: wood c: 50)
            (up-filter-status c: status-resource c: list-active); including chopped tree
            (up-find-resource c: wood c: 50)
            (up-find-resource c: stone c: 50)
            (up-find-resource c: gold c: 50)
            (up-get-search-state gl-tmp-local-total)
        )
