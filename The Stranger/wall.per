            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)

            (up-compare-goal gl-tmp-remote-total > 0)
            =>
            ;(up-modify-goal gl-wall-building-tile-from-criterion c:+ 1)
            ;(up-chat-data-to-all "resources %d are found when placing wall" g: gl-tmp-remote-total)
            (up-jump-direct g: gl-wall-building-tile-from-criterion-for-id); continue
        )

        (defrule
            (goal gl-wall-calculated 1)
            (up-compare-goal gl-wall-tc-pos-x >= 0)
            (goal gl-wall-building-pending 1)
            (goal gl-wall-deciding-building-position-for-end 0)
            (goal gl-wall-building-tile-from-criterion-for-end 0)
            =>
            (set-goal gl-wall-building-pending 0)
            (set-goal gl-wall-building-tile-from-criterion-for-end 1)
            (up-copy-point gl-wall-building-pos-x gl-tmp-x)
            ;(up-send-flare gl-wall-building-pos-x)
        )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)
        (goal gl-wall-building-tile-from-criterion-for-end 0)
        =>
        (up-jump-direct g: gl-wall-building-tile-from-criterion-for-id)
    )

    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 0)
        (goal gl-wall-deciding-building-position-for-end 0)
        =>
        ; break
        (set-goal gl-wall-deciding-building-position-for-end 1)
    )

    ; change the criterion to the next one in the order
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)
        =>
        (up-modify-goal gl-wall-building-criterion g:+ gl-wall-building-direction)
        (set-goal gl-wall-building-tile-from-criterion 0)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (up-compare-goal gl-wall-building-criterion > wall-north-west) ; wall-north-west is the last one in the order, so go to 0 (wall-north)
        =>
        (set-goal gl-wall-building-criterion wall-north)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (up-compare-goal gl-wall-building-criterion < wall-north) ; wall-north the first one in the order, so go to the last (wall-north-west)
        =>
        (set-goal gl-wall-building-criterion wall-north-west)
    )


    (defrule ; check whether going around all places
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)
        =>
        (up-modify-goal gl-tmp g:= gl-wall-building-criterion-before-changing)
        (up-modify-goal gl-tmp g:- gl-wall-building-criterion)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-tmp 0)
        =>
        ; cannot have building position as a part of the wall in all places, so this trial is no longer available
        (set-goal gl-wall-building-pending 0)
        (set-goal gl-wall-building-unavailable 1)
        (set-goal gl-wall-deciding-building-position-for-end 1)
        (chat-to-all "cannot find building position as a part of the wall, giving up")
    )
(defrule
    (goal gl-wall-calculated 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-building-pending 1)
    (goal gl-wall-deciding-building-position-for-end 0)
    =>
    (up-jump-direct g: gl-wall-deciding-building-position-for-id)
)