    (goal gl-wall-north-has-tree 0)
    (goal gl-wall-north-east-has-tree 1)
    =>
    (up-copy-point gl-wall-north-pos-x gl-wall-north-west-pos-x)
    (up-add-point gl-wall-north-pos-x gl-wall-north-east-pos-x c: 1)
    (up-modify-goal gl-wall-north-pos-x c:/ 2)
    (up-modify-goal gl-wall-north-pos-y c:/ 2)
)

