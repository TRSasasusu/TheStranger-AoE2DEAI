(defconst gl-wall-right-corner-pos-x 439)
(defconst gl-wall-right-corner-pos-y 440)
(defconst gl-wall-has-edge 441)
(defconst gl-wall-calculated 446)

(defrule
    (true)
    =>
    (set-goal gl-wall-start 0) ; test now
    (set-goal gl-wall-calculated 0)
    (set-goal gl-wall-start-walling 0)
    (set-goal gl-wall-tc-pos-x -1)
    (set-goal gl-wall-building-pos-x -1)
    (set-goal gl-wall-distance-from-tc 18)
    (set-goal gl-wall-distance-to-tree 10)
    (set-goal gl-wall-distance-to-edge 30)

    (set-goal gl-wall-north-has-tree 0)
    (set-goal gl-wall-north-east-has-tree 0)
    (set-goal gl-wall-east-has-tree 0)
    (set-goal gl-wall-south-east-has-tree 0)
    (set-goal gl-wall-south-has-tree 0)
    (set-goal gl-wall-south-west-has-tree 0)
    (set-goal gl-wall-west-has-tree 0)
    (set-goal gl-wall-north-west-has-tree 0)

    (set-goal gl-wall-north-not-used 0)
    (set-goal gl-wall-north-east-not-used 0)
    (set-goal gl-wall-east-not-used 0)
    (set-goal gl-wall-south-east-not-used 0)
    (set-goal gl-wall-south-not-used 0)
    (set-goal gl-wall-south-west-not-used 0)
    (set-goal gl-wall-west-not-used 0)
    (set-goal gl-wall-north-west-not-used 0)

    (set-goal gl-wall-has-edge 0)

    (up-get-point position-map-size gl-wall-right-corner-pos-x)
    (disable-self)
)

(defrule
    (game-time > 5)
    =>
    (set-goal gl-wall-start 1)
    (disable-self)
)

(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    =>
    (up-full-reset-search)
    (up-find-local c: town-center c: 5)
    (up-get-search-state gl-tmp-local-total)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-tmp-local-total > 0)
    =>
    (up-set-target-object search-local c: 0)
    (up-get-point position-object gl-wall-tc-pos-x)
)

(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-north-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-north-pos-x g:+ gl-wall-distance-from-tc)
    (up-modify-goal gl-wall-north-pos-y g:- gl-wall-distance-from-tc)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-north-east-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-north-east-pos-x g:+ gl-wall-distance-from-tc)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-east-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-east-pos-x g:+ gl-wall-distance-from-tc)
    (up-modify-goal gl-wall-east-pos-y g:+ gl-wall-distance-from-tc)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-south-east-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-south-east-pos-y g:+ gl-wall-distance-from-tc)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-south-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-south-pos-x g:- gl-wall-distance-from-tc)
    (up-modify-goal gl-wall-south-pos-y g:+ gl-wall-distance-from-tc)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-south-west-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-south-west-pos-x g:- gl-wall-distance-from-tc)
