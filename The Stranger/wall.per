(defconst gl-wall-building-criterion 456); 0: north, 1: north-east, 2: east, 3: south-east, 4: south, 5: south-west, 6: west, 7: north-west
(defconst wall-north 0)
(defconst wall-north-east 1)
(defconst wall-east 2)
(defconst wall-south-east 3)
(defconst wall-south 4)
(defconst wall-south-west 5)
(defconst wall-west 6)
(defconst wall-north-west 7)
(defconst gl-wall-building-direction 457); 1: clockwise, -1: counter-clockwise
(defconst gl-wall-deciding-building-position-for-end 458)
(defconst gl-wall-deciding-building-position-for-id 459)
(defconst gl-wall-building-tile-from-criterion 460)
(defconst gl-wall-building-tile-from-criterion-for-end 461)
(defconst gl-wall-building-tile-from-criterion-for-id 462)
(defconst gl-wall-building-criterion-before-changing 463)
