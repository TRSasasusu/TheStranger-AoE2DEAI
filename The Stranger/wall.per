; west corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-copy-point gl-tmp-x gl-wall-tc-pos-x)
    (up-modify-goal gl-tmp-x g:- gl-wall-distance-to-edge)
    (up-modify-goal gl-tmp-y g:- gl-wall-distance-to-edge)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-x <= 0)
    (up-compare-goal gl-tmp-y <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-west-not-used 1)
    (set-goal gl-wall-north-west-pos-y 0)
    (set-goal gl-wall-south-west-pos-y 0)
)
; north corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-modify-goal gl-tmp-x g:= gl-wall-right-corner-pos-x)
    (up-modify-goal gl-tmp-x g:- gl-wall-tc-pos-x)
    (up-modify-goal gl-tmp-x g:- gl-wall-distance-to-edge)

    (up-modify-goal gl-tmp-y g:= gl-wall-tc-pos-y)
    (up-modify-goal gl-tmp-y g:- gl-wall-distance-to-edge)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)

    (up-compare-goal gl-tmp-x <= 0)
    (up-compare-goal gl-tmp-y <= 0)
    =>
    (set-goal gl-wall-has-edge 1)
    (set-goal gl-wall-north-not-used 1)
    (up-modify-goal gl-wall-north-east-pos-x g:= gl-wall-right-corner-pos-x)
    (set-goal gl-wall-north-west-pos-y 0)
)
; south corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-modify-goal gl-tmp-x g:= gl-wall-tc-pos-x)
    (up-modify-goal gl-tmp-x g:- gl-wall-distance-to-edge)

    (up-modify-goal gl-tmp-y g:= gl-wall-right-corner-pos-y)
