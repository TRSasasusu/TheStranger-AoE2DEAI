; south east corner check
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-has-edge 0)
    =>
    (up-modify-goal gl-tmp-y g:= gl-wall-right-corner-pos-y)
    (up-modify-goal gl-tmp-y g:- gl-wall-tc-pos-y)
    (up-modify-goal gl-tmp-y g:- gl-wall-distance-to-edge)
