; set building position as a part of the wall
; we need to check if the position is valid and if not, we need to find a new one
; this is done by making the for loop
(defrule
    (goal gl-wall-calculated 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-building-pending 1)
    =>
    (set-goal gl-wall-deciding-building-position-for-end 0)
    (up-modify-goal gl-wall-building-criterion-before-changing g:= gl-wall-building-criterion)
)
(defrule
    (goal gl-wall-calculated 1)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (goal gl-wall-building-pending 1)
    (goal gl-wall-deciding-building-position-for-end 0)
    =>
    (up-get-rule-id gl-wall-deciding-building-position-for-id)
)
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)
        =>
        (set-goal gl-wall-building-tile-from-criterion-for-skip 0)
    )
    ; from the criterion and the direction we can get the two points between which we will check for the building position
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-north)
        (goal gl-wall-building-direction 1)
        =>
        (up-copy-point gl-tmp-x gl-wall-north-pos-x)
        (up-copy-point gl-tmp2-x gl-wall-north-east-pos-x)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-north)
        (goal gl-wall-building-direction 1)
        (or
            (goal gl-wall-north-not-used 1)
            (goal gl-wall-north-east-not-used 1)
        )
        =>
        (set-goal gl-wall-building-tile-from-criterion-for-skip 1)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-north-east)
        (goal gl-wall-building-direction 1)
        =>
        (up-copy-point gl-tmp-x gl-wall-north-east-pos-x)
        (up-copy-point gl-tmp2-x gl-wall-east-pos-x)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-north-east)
        (goal gl-wall-building-direction 1)
        (or
            (goal gl-wall-north-east-not-used 1)
            (goal gl-wall-east-not-used 1)
        )
        =>
        (set-goal gl-wall-building-tile-from-criterion-for-skip 1)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-east)
        (goal gl-wall-building-direction 1)
        =>
        (up-copy-point gl-tmp-x gl-wall-east-pos-x)
        (up-copy-point gl-tmp2-x gl-wall-south-east-pos-x)
    )
    (defrule
        (goal gl-wall-calculated 1)
        (up-compare-goal gl-wall-tc-pos-x >= 0)
        (goal gl-wall-building-pending 1)
        (goal gl-wall-deciding-building-position-for-end 0)

        (goal gl-wall-building-criterion wall-east)
