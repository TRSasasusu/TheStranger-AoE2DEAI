(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-copy-point gl-wall-north-west-pos-x gl-wall-tc-pos-x)
    (up-modify-goal gl-wall-north-west-pos-y g:- gl-wall-distance-from-tc)
)

(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (up-set-target-point gl-wall-north-pos-x)
    (up-full-reset-search)

    (up-filter-status c: status-ready c: list-active)
    (up-filter-distance c: -1 g: gl-wall-distance-to-tree)
    (up-find-resource c: wood c: 50)
    (up-get-search-state gl-tmp-local-total)
    (up-chat-data-to-all "number of trees: %d in north" g: gl-tmp-remote-total)
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    (up-compare-goal gl-tmp-remote-total > 2)
    =>
    (up-clean-search search-remote object-data-distance search-order-asc)
    (up-set-target-object search-remote c: 0)

    (up-get-point position-object gl-wall-north-pos-x)
    (set-goal gl-wall-north-has-tree 1)
    (chat-to-all "north tree found")
)
(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
