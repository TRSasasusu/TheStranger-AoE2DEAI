(defrule
    (goal gl-wall-start 1)
    (goal gl-wall-calculated 0)
    (up-compare-goal gl-wall-tc-pos-x >= 0)
    =>
    (set-goal gl-wall-calculated 1)
    (set-goal gl-wall-building-pending 1)
    (up-modify-goal gl-wall-building-criterion-initial g:= gl-wall-building-criterion)
    (chat-to-all "wall calculated")
    (up-chat-data-to-all "gl-wall-has-edge: %d" g: gl-wall-has-edge)
    (up-chat-data-to-all "gl-wall-building-criterion: %d" g: gl-wall-building-criterion)
    (up-chat-data-to-all "gl-wall-building-direction: %d" g: gl-wall-building-direction)
)


