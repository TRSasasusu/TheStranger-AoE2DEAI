(defconst t-attack-timer 13)
(defconst gl-attack-target-rnd 131)
(defconst gl-attack-target-local-total 132)
(defconst gl-attack-target-local-last 133)
(defconst gl-attack-target-remote-total 134)
(defconst gl-attack-target-remote-last 135)
(defconst gl-attack-target-x 136)
(defconst gl-attack-target-y 137)
(defconst gl-attacking-unit-type 138)
(defconst gl-attack-only-attack-move 139)
(defrule
    (true)
    =>
    (set-goal gl-attack-target-rnd 0)
    (set-goal gl-attack-target-local-total 0)
    (set-goal gl-attacking-unit-type archer-line)
    (set-goal gl-attack-only-attack-move 0)
)
;(defrule
;    (unit-type-count militiaman-line >= 2)
;    (up-timer-status t-attack-timer != timer-running)
;    =>
;    (up-set-offense-priority c: lumber-camp c: 1)
;    (up-set-offense-priority c: mill c: 2)
;    (up-set-offense-priority c: mining-camp c: 3)
;    (up-set-offense-priority c: town-center c: 4)
;    (set-strategic-number sn-percent-attack-soldiers 100)
;    (set-strategic-number sn-percent-attack-boats 100)
;    (attack-now)
;    (enable-timer t-attack-timer 60)
;    (chat-to-all "start attacking!")
;    (generate-random-number 10)
;    (up-get-fact random-number 0 gl-attack-go-deep)
;    ;(up-chat-data-to-all "start attacking!")
;)
(defrule
    ;(or
        ;(unit-type-count archer-line >= 2)
        ;(unit-type-count cavalry-archer-line >= 2)
        ;(unit-type-count skirmisher-line >= 2)
        ;(unit-type-count militiaman-line >= 2)
        ;(unit-type-count spearman-line >= 2)
        ;(unit-type-count scout-cavalry-line >= 2)
        ;(unit-type-count eagle-warrior-line >= 2)
    ;)
    (soldier-count >= 2)
    (up-timer-status t-attack-timer != timer-running)
    =>
    (up-full-reset-search)
    (generate-random-number 21);25
    (up-get-fact random-number 0 gl-attack-target-rnd)
    ;(up-chat-data-to-all "gl-attack-target-rnd: %d" g: gl-attack-target-rnd)
    (enable-timer t-attack-timer 10)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 5)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-find-remote c: lumber-camp c: 5)
    (up-get-search-state gl-attack-target-local-total)
    (chat-to-all "try attacking to lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 5)
    (goal gl-attack-target-remote-total 0)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (set-goal gl-attack-target-rnd 5)
    (chat-to-all "attacking to NOT lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 5)
    (up-compare-goal gl-attack-target-rnd < 8)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-find-remote c: mill c: 5)
    (up-get-search-state gl-attack-target-local-total)
    (chat-to-all "try attacking to lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 5)
    (up-compare-goal gl-attack-target-rnd < 8)
    (goal gl-attack-target-remote-total 0)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (set-goal gl-attack-target-rnd 8)
    (chat-to-all "attacking to NOT mill")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 8)
    (up-compare-goal gl-attack-target-rnd < 11)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-find-remote c: mining-camp c: 5)
    (up-get-search-state gl-attack-target-local-total)
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 8)
    (up-compare-goal gl-attack-target-rnd < 11)
    (goal gl-attack-target-remote-total 0)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (set-goal gl-attack-target-rnd 11)
    (chat-to-all "attacking to NOT mining-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 11)
    (up-compare-goal gl-attack-target-rnd < 22)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-find-remote c: town-center c: 5)
    (up-get-search-state gl-attack-target-local-total)
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 11)
    (up-compare-goal gl-attack-target-rnd < 22)
    (goal gl-attack-target-remote-total 0)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (set-goal gl-attack-target-rnd 22)
    (chat-to-all "attacking to NOT town-center or deep")
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 13)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (generate-random-number 100)
    (up-get-fact random-number 0 gl-tmp)
    ;(up-chat-data-to-all "gl-attack-target-rnd: %d" g: gl-attack-target-rnd)
    ;(up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp c:- 1)
    ;(up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp g:* gl-attack-target-remote-total)
    ;(up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp c:z/ 100)
    ;(up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-set-target-object search-remote g: gl-tmp)
    (up-target-objects 1 action-default -1 stance-aggressive)
    (up-get-point position-object gl-tmp-x)
    (up-copy-point gl-attack-target-x gl-tmp-x)
)

(defconst gl-enemy-tc-x 154)
(defconst gl-enemy-tc-y 155)
(defconst gl-position-self-x 162)
(defconst gl-position-self-y 163)
(defconst gl-deep-point-x 164)
(defconst gl-deep-point-y 165)
(defconst gl-self-to-enemy-dist 166)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 13)
    (up-compare-goal gl-attack-target-rnd < 22)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (generate-random-number 100)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 1)
    (up-modify-goal gl-tmp g:* gl-attack-target-remote-total)
    (up-modify-goal gl-tmp c:z/ 100)
    (up-set-target-object search-remote g: gl-tmp)
    (up-get-point position-object gl-enemy-tc-x)
    ;(up-full-reset-search)
    ;(up-find-local c: militiaman-line c: 8)
    (up-get-point position-self gl-position-self-x)
    (up-send-flare gl-position-self-x)
    (up-copy-point gl-deep-point-x gl-enemy-tc-x)
    ;(up-send-flare gl-deep-point-x)
    ;(up-add-point gl-deep-point-x gl-position-self-x c:- 1)
    (up-modify-goal gl-deep-point-x g:- gl-position-self-x)
    (up-modify-goal gl-deep-point-y g:- gl-position-self-y)
    ;(up-send-flare gl-deep-point-x)
    (up-get-point-distance gl-position-self-x gl-enemy-tc-x gl-self-to-enemy-dist)
    (up-modify-goal gl-self-to-enemy-dist c:/ 2)
    (up-modify-goal gl-deep-point-x g:/ gl-self-to-enemy-dist)
    (up-modify-goal gl-deep-point-y g:/ gl-self-to-enemy-dist)
    (up-modify-goal gl-deep-point-x c:* 10)
    (up-modify-goal gl-deep-point-y c:* 10)
    (up-add-point gl-deep-point-x gl-enemy-tc-x c: 1)
    ;(up-send-flare gl-deep-point-x)
    (generate-random-number 30)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 15)
    (up-modify-goal gl-deep-point-x g:+ gl-tmp)
    (generate-random-number 30)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 15)
    (up-modify-goal gl-deep-point-y g:+ gl-tmp)
    (up-copy-point gl-attack-target-x gl-deep-point-x)
    ;(up-target-point gl-deep-point-x action-default -1 stance-stand-ground)
    ;(chat-to-all "try going to deep")
    ;(up-send-flare gl-deep-point-x)
)

(defconst gl-attack-unit-local-total 167)
(defconst gl-attack-unit-local-last 168)
(defconst gl-attack-unit-remote-total 169)
(defconst gl-attack-unit-remote-last 170)
(defconst gl-attacking-vil-local-total 171)
(defconst gl-attacking-vil-local-last 172)
(defconst gl-attacking-vil-remote-total 173)
(defconst gl-attacking-vil-remote-last 174)
;(defrule
;    (up-compare-goal gl-attack-target-rnd > 0)
;    (up-compare-goal gl-attack-target-rnd < 22)
;    =>
;    (up-find-local c: militiaman-line c: 220)
;    (up-target-point gl-attack-target-x action-attack-move -1 -1)
;    (up-send-flare gl-attack-target-x)
;)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 22)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-find-local g: gl-attacking-unit-type c: 220)
    (up-get-search-state gl-attack-unit-local-total)
    (generate-random-number 100)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 1)
    (up-modify-goal gl-tmp g:* gl-attack-unit-local-total)
    (up-modify-goal gl-tmp c:z/ 100)
    (up-chat-data-to-all "units with %d go!" g: gl-tmp)
    (up-set-target-object search-local g: gl-tmp)
    (up-get-point position-object gl-tmp-x)
    (up-set-target-point gl-tmp-x)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 3)
    (up-find-local g: gl-attacking-unit-type c: 20)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 22)
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-set-target-object search-local c: 0)
    (up-get-point position-object gl-tmp-x)
    (up-set-target-point gl-tmp-x)
    (up-reset-search 0 0 1 1)
    (up-reset-filters)
    (up-filter-distance c: -1 c: 6)
    (up-find-remote c: villager-class c: 10)
    (up-get-search-state gl-attacking-vil-local-total)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 22)
    (or
        (up-compare-goal gl-attacking-vil-remote-total > 0)
        (goal gl-attack-only-attack-move 1)
    )
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (generate-random-number 6)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 3)
    (up-modify-goal gl-attack-target-x g:+ gl-tmp)
    (generate-random-number 6)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 3)
    (up-modify-goal gl-attack-target-y g:+ gl-tmp)
    (up-target-point gl-attack-target-x action-attack-move -1 -1)
    (chat-to-all "attack move!")
    (up-send-flare gl-attack-target-x)
    (up-full-reset-search)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 22)
    (and
        (goal gl-attacking-vil-remote-total 0)
        (goal gl-attack-only-attack-move 0)
    )
    (up-object-type-count g: gl-attacking-unit-type >= 2)
    =>
    (up-target-point gl-attack-target-x action-move -1 -1)
    (chat-to-all "only moving!")
    (up-send-flare gl-attack-target-x)
    (up-full-reset-search)
)


(defrule
    (true)
    =>
    (do-nothing)
    ;(up-compare-goal gl-attack-target-rnd >= 22)
    ;(up-object-type-count g: gl-attacking-unit-type >= 2)
    ;=>
    ;(up-set-offense-priority c: lumber-camp c: 1)
    ;(up-set-offense-priority c: mill c: 2)
    ;(up-set-offense-priority c: mining-camp c: 3)
    ;(up-set-offense-priority c: town-center c: 4)
    ;(set-strategic-number sn-percent-attack-soldiers 100)
    ;(set-strategic-number sn-percent-attack-boats 100)
    ;(chat-to-all "attack now!")
    ;(attack-now)
)


(defrule
    (goal gl-attacking-unit-type archer-line)
    =>
    (set-goal gl-attacking-unit-type cavalry-archer-line)
    (up-jump-rule -16)
)
(defrule
    (goal gl-attacking-unit-type cavalry-archer-line)
    =>
    (set-goal gl-attacking-unit-type skirmisher-line)
    (up-jump-rule -17)
)
(defrule
    (goal gl-attacking-unit-type skirmisher-line)
    =>
    (set-goal gl-attacking-unit-type militiaman-line)
    (up-jump-rule -18)
)
(defrule
    (goal gl-attacking-unit-type militiaman-line)
    =>
    (set-goal gl-attacking-unit-type spearman-line)
    (up-jump-rule -19)
)
(defrule
    (goal gl-attacking-unit-type spearman-line)
    =>
    (set-goal gl-attacking-unit-type scout-cavalry-line)
    (up-jump-rule -20)
)
(defrule
    (goal gl-attacking-unit-type scout-cavalry-line)
    =>
    (set-goal gl-attacking-unit-type eagle-warrior-line)
    (up-jump-rule -21)
)
(defrule
    (goal gl-attacking-unit-type eagle-warrior-line)
    =>
    (set-goal gl-attacking-unit-type mangonel-line)
    ;(chat-to-all "mangonel go!!")
    (set-goal gl-attack-only-attack-move 1)
    (up-jump-rule -22)
)
(defrule
    (goal gl-attacking-unit-type mangonel-line)
    =>
    (set-goal gl-attacking-unit-type knight-line)
    (set-goal gl-attack-only-attack-move 0)
    (up-jump-rule -23)
)
(defrule
    (goal gl-attacking-unit-type knight-line)
    =>
    (set-goal gl-attacking-unit-type bombard-cannon-line)
    (set-goal gl-attack-only-attack-move 1)
    (up-jump-rule -24)
)
(defrule
    (goal gl-attacking-unit-type bombard-cannon-line)
    =>
    (set-goal gl-attacking-unit-type trebuchet)
    (set-goal gl-attack-only-attack-move 1)
    (up-jump-rule -25)
)