(defconst gl-avoid-attack-player-id 180)
(defconst gl-avoid-attack-player-id-for-id 181)
(defconst gl-avoid-attack-player-id-for-end 182)
(defconst gl-avoid-attack-focus-player-bak 183)
(defconst gl-threat-target-id 185)
(defconst gl-threat-target-pos-x 186)
(defconst gl-threat-target-pos-y 187)
(defconst gl-threat-target-num-in-group 188)
(defconst gl-threat-source-pos-x 189)
(defconst gl-threat-source-pos-y 190)
(defconst gl-threat-target-class-id 191)
(defconst gl-threat-target-class-id-for-id 192)
(defconst gl-threat-target-class-id-for-end 193)
(defconst gl-threat-source-class-id 194)
(defconst gl-threat-source-class-id-for-id 195)
(defconst gl-threat-source-class-id-for-end 196)
(defconst gl-threat-hope-distance 197)

; initialize
(defrule
    (true)
    =>
    (set-goal gl-avoid-attack-player-id 0)
    (up-modify-goal gl-avoid-attack-focus-player-bak s:= sn-focus-player-number)
)

; for player
(defrule
    (true)
    =>
    (set-goal gl-avoid-attack-player-id-for-end 0)
)
(defrule
    (goal gl-avoid-attack-player-id-for-end 0)
    =>
    (up-get-rule-id gl-avoid-attack-player-id-for-id)
    ;(up-chat-data-to-all "gl-avoid-attack-player-id-for-id: %d" g: gl-avoid-attack-player-id-for-id)
    ;(up-chat-data-to-all "gl-avoid-attack-player-id: %d" g: gl-avoid-attack-player-id)
    (up-modify-goal gl-avoid-attack-player-id c:+ 1)
    (up-modify-sn sn-focus-player-number g:= gl-avoid-attack-player-id)
    ;(up-chat-data-to-all "sn-focus-player-number: %d" s: sn-focus-player-number)
)
(defrule
    (goal gl-avoid-attack-player-id-for-end 0)
    (up-compare-goal gl-avoid-attack-player-id > 8)
    =>
    (set-goal gl-avoid-attack-player-id-for-end 1)
)

    ; check is this player enemy
    (defrule
        (goal gl-avoid-attack-player-id-for-end 0)
        (not(and
            (player-valid focus-player)
            (players-stance focus-player enemy)
        ))
        =>
        ;(up-chat-data-to-all "player %d is not enemy" s: sn-focus-player-number)
        (up-jump-direct g: gl-avoid-attack-player-id-for-id)
    )

    (defrule
        (goal gl-avoid-attack-player-id-for-end 0)
        =>
        (set-goal gl-threat-target-class-id 0)
        (set-goal gl-threat-target-class-id-for-end 0)
    )
    (defrule
        (goal gl-avoid-attack-player-id-for-end 0)
        (goal gl-threat-target-class-id-for-end 0)
        =>
        (up-get-rule-id gl-threat-target-class-id-for-id)
    )

        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id cavalry-archer-class)
            =>
            (set-goal gl-threat-target-class-id-for-end 1); endfor flag
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id militia)
            =>
            (set-goal gl-threat-target-class-id cavalry-archer-class)
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id archer-line)
            =>
            (set-goal gl-threat-target-class-id militia)
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id eagle-warrior-line)
            =>
            (set-goal gl-threat-target-class-id archer-line)
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id scout-cavalry-line)
            =>
            (set-goal gl-threat-target-class-id eagle-warrior-line)
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-target-class-id 0)
            =>
            (set-goal gl-threat-target-class-id scout-cavalry-line)
        )


        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            =>
            (set-goal gl-threat-source-class-id 0)
            (set-goal gl-threat-source-class-id-for-end 0)
        )
        (defrule
            (goal gl-avoid-attack-player-id-for-end 0)
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-source-class-id-for-end 0)
            =>
            (up-get-rule-id gl-threat-source-class-id-for-id)
        )

            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)
                (goal gl-threat-source-class-id all-units-class)
                =>
                (set-goal gl-threat-source-class-id-for-end 1) ; endfor flag
            )

            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)
                (goal gl-threat-source-class-id skirmisher)
                =>
                (set-goal gl-threat-source-class-id all-units-class)
                (set-goal gl-threat-hope-distance 11)
            )

            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)
                (goal gl-threat-source-class-id villager-class)
                =>
                (set-goal gl-threat-source-class-id skirmisher)
                (set-goal gl-threat-hope-distance 10)
            )

            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)
                (goal gl-threat-source-class-id 0)
                =>
                (set-goal gl-threat-source-class-id villager-class)
                (set-goal gl-threat-hope-distance 6)
            )

            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)
                =>
                (set-goal gl-threat-source-pos-x -1)
                (set-goal gl-threat-target-pos-x -1)
                ;(chat-to-all "hogehoge")
                (set-goal gl-tmp-local-total 0)
                (set-goal gl-tmp-remote-total 0)
            )

            ;; villager
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id villager-class)
                (or
                    (and
                        (goal gl-threat-target-class-id scout-cavalry-line)
                        (not(research-completed ri-scale-barding))
                    )
                    (or
                        (and
                            (goal gl-threat-target-class-id eagle-warrior-line)
                            (not(research-completed ri-scale-mail))
                        )
                        (or
                            (and
                                (goal gl-threat-target-class-id archer-line)
                                (not(research-completed ri-crossbow))
                            )
                            (goal gl-threat-target-class-id militia)
                        )
                    )
                )
                =>
                (up-full-reset-search)
                (up-filter-include -1 actionid-attack -1 -1)
                ;(up-filter-include -1 -1 orderid-attack -1)
                (up-find-remote g: gl-threat-source-class-id c: 5)
                (up-get-search-state gl-tmp-local-total)
                ;(up-chat-data-to-all "vil num: %d" g: gl-tmp-remote-total)
            )
            ;; skirmisher
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id skirmisher)
                (and
                    (goal gl-threat-target-class-id archer-line)
                    (not(research-completed ri-crossbow))
                )
                =>
                (up-full-reset-search)
                (up-find-remote g: gl-threat-source-class-id c: 10)
                (up-get-search-state gl-tmp-local-total)
                ;(up-chat-data-to-all "skirm num: %d" g: gl-tmp-remote-total)
            )
            ;; military
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id all-units-class)
                (goal gl-threat-target-class-id cavalry-archer-class)
                =>
                (up-full-reset-search)
                (up-filter-include cmdid-military -1 -1 -1)
                (up-find-remote c: all-units-class c: 50)
                (up-get-search-state gl-tmp-local-total)
            )

            ; set source as target object and position
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (up-compare-goal gl-tmp-remote-total > 0)
                =>
                (generate-random-number 100)
                (up-get-fact random-number 0 gl-tmp)
                (up-modify-goal gl-tmp c:- 1)
                (up-modify-goal gl-tmp g:* gl-tmp-remote-total)
                (up-modify-goal gl-tmp c:z/ 100)
                (up-set-target-object search-remote g: gl-tmp)
                ;(chat-to-all "attacked by vil!")
                ;(up-set-target-object search-remote c: 0)
                (up-get-point position-object gl-threat-source-pos-x)
                (up-set-target-point gl-threat-source-pos-x)
            )

            ;; villager
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id villager-class)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 2)
                (up-find-local g: gl-threat-target-class-id c: 5)
                (up-get-search-state gl-tmp-local-total)
            )
            (defrule ; to include only 1
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id villager-class)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                (up-compare-goal gl-tmp-local-total > 1)
                =>
                (set-goal gl-tmp-local-total 0)
            )
            ;; skirmisher
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id skirmisher)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 9)
                (up-find-remote g: gl-threat-source-class-id c: 50)
                (up-get-search-state gl-tmp-local-total)
                (up-modify-goal gl-tmp g:= gl-tmp-remote-total); gl-tmp (>=1) is now #skirmisher
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 9)
                (up-find-local g: gl-threat-target-class-id c: 50)
                (up-get-search-state gl-tmp-local-total)
                (up-modify-goal gl-tmp2 g:= gl-tmp-local-total); gl-tmp2 is now #archer-line
                (up-modify-goal gl-tmp2 g:/ gl-tmp); gl-tmp-local-total is now #archer-line/#skirmisher
                ;(up-chat-data-to-all "#archer-line/#skirm: %d" g: gl-tmp2)
            )
            (defrule ; to include only #archer-line/#skirmisher < 3
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id skirmisher)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                (up-compare-goal gl-tmp2 >= 3)
                =>
                (set-goal gl-tmp-local-total 0)
                ;(chat-to-all "ignore this skirm")
            )
            ;; military
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id all-units-class)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                =>
                (up-full-reset-search)
                (up-filter-include cmdid-military -1 -1 -1)
                (up-filter-distance c: -1 c: 9)
                (up-find-remote g: gl-threat-source-class-id c: 50)
                (up-get-search-state gl-tmp-local-total)
                (up-modify-goal gl-tmp g:= gl-tmp-remote-total); gl-tmp (>=1) is now #military
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 9)
                (up-find-local g: gl-threat-target-class-id c: 50)
                (up-get-search-state gl-tmp-local-total)
                (up-modify-goal gl-tmp2 g:= gl-tmp-local-total); gl-tmp2 is now #cavalry-archer-class
                (up-modify-goal gl-tmp2 g:/ gl-tmp); gl-tmp-local-total is now #cavalry-archer-class/#military
                ;(up-chat-data-to-all "#cavalry-archer-class/#military: %d" g: gl-tmp2)
            )
            (defrule ; to include only #cavalry-archer-class/#military < 3
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (goal gl-threat-source-class-id all-units-class)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                (up-compare-goal gl-tmp2 >= 3)
                =>
                (set-goal gl-tmp-local-total 0)
                ;(chat-to-all "ignore this military")
            )

            ; set target as target object and position
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                (up-compare-goal gl-tmp-local-total > 0)
                =>
                (generate-random-number 100)
                (up-get-fact random-number 0 gl-tmp)
                (up-modify-goal gl-tmp c:- 1)
                (up-modify-goal gl-tmp g:* gl-tmp-local-total)
                (up-modify-goal gl-tmp c:z/ 100)
                (up-set-target-object search-local g: gl-tmp)
                ;(up-set-target-object search-local c: 0)
                (up-get-point position-object gl-threat-target-pos-x)
                (up-set-target-point gl-threat-target-pos-x)
                ;(chat-to-all "set target pos")
            )

            ;*** avoid ***
            (defrule
                (goal gl-avoid-attack-player-id-for-end 0)
                (goal gl-threat-target-class-id-for-end 0)
                (goal gl-threat-source-class-id-for-end 0)

                (up-compare-goal gl-threat-source-pos-x >= 0)
                (up-compare-goal gl-threat-target-pos-x >= 0)
                =>
                (up-get-point-distance gl-threat-target-pos-x gl-threat-source-pos-x gl-enemy-tc-unit-dist)
                (up-modify-goal gl-enemy-tc-unit-dist c:max 1)
                (up-copy-point gl-avoiding-target-x gl-threat-target-pos-x)
                ;(up-modify-goal gl-avoiding-target-x g:= gl-avoiding-unit-x)
                ;(up-modify-goal gl-avoiding-target-y g:= gl-avoiding-unit-y)
                (up-modify-goal gl-avoiding-target-x g:- gl-threat-source-pos-x)
                (up-modify-goal gl-avoiding-target-y g:- gl-threat-source-pos-y)
                ;(up-chat-data-to-all "raw gl-avoiding-target-x: %d" g: gl-avoiding-target-x)
                ;(up-chat-data-to-all "raw gl-avoiding-target-y: %d" g: gl-avoiding-target-y)
                ;(up-chat-data-to-all "raw gl-enemy-tc-unit-dist: %d" g: gl-enemy-tc-unit-dist)
                (up-modify-goal gl-avoiding-target-x c:* 100)
                (up-modify-goal gl-avoiding-target-y c:* 100)
                ;(up-modify-goal gl-enemy-tc-unit-dist c:/ 2)
                (up-modify-goal gl-avoiding-target-x g:/ gl-enemy-tc-unit-dist)
                (up-modify-goal gl-avoiding-target-y g:/ gl-enemy-tc-unit-dist)
                ;(up-modify-goal gl-enemy-tc-unit-dist-minus c:= 14)
                (up-modify-goal gl-enemy-tc-unit-dist-minus g:= gl-threat-hope-distance)
                (up-modify-goal gl-enemy-tc-unit-dist-minus g:- gl-enemy-tc-unit-dist)
                (up-modify-goal gl-avoiding-target-x g:* gl-enemy-tc-unit-dist-minus)
                (up-modify-goal gl-avoiding-target-y g:* gl-enemy-tc-unit-dist-minus)
                (up-modify-goal gl-avoiding-target-x c:/ 100)
                (up-modify-goal gl-avoiding-target-y c:/ 100)
                (up-modify-goal gl-avoiding-cross-x g:= gl-avoiding-target-y)
                (up-modify-goal gl-avoiding-cross-y g:= gl-avoiding-target-x)
                (up-modify-goal gl-avoiding-cross-x c:* -1)
                ;(up-modify-goal gl-avoiding-cross-x c:* 1.5)
                ;(up-modify-goal gl-avoiding-cross-y c:* 1.5)
                ;(up-modify-goal gl-avoiding-cross-y c:* 1.41) ; due to diagonal coordinate
                ;(up-modify-goal gl-avoiding-cross-y g:- gl-avoiding-target-y) ; due to diagonal coordinate
                (generate-random-number 3)
                (up-get-fact random-number 0 gl-avoiding-cross-corr)
                (up-modify-goal gl-avoiding-cross-corr g:* gl-avoiding-rotate-direction)
                (up-modify-goal gl-avoiding-cross-x g:* gl-avoiding-cross-corr)
                (up-modify-goal gl-avoiding-cross-y g:* gl-avoiding-cross-corr)
                ;(up-modify-goal gl-avoiding-cross-corr c:- 4)
                ;(up-modify-goal gl-avoiding-cross-x g:* gl-avoiding-cross-corr)
                ;(up-modify-goal gl-avoiding-cross-y g:* gl-avoiding-cross-corr)
                ;(up-send-flare gl-avoiding-target-x)
                ;(up-send-flare gl-avoiding-cross-x)
                ;(up-chat-data-to-all "gl-avoiding-target-x: %d" g: gl-avoiding-target-x)
                ;(up-chat-data-to-all "gl-avoiding-target-y: %d" g: gl-avoiding-target-y)
                ;(up-chat-data-to-all "gl-avoiding-cross-x: %d" g: gl-avoiding-cross-x)
                ;(up-chat-data-to-all "gl-avoiding-cross-y: %d" g: gl-avoiding-cross-y)
                (up-add-point gl-avoiding-target-x gl-avoiding-cross-x c: 1)
                ;(up-modify-goal gl-avoiding-target-x g:+ gl-avoiding-cross-x)
                ;(up-modify-goal gl-avoiding-target-y g:+ gl-avoiding-cross-y)
                (up-add-point gl-avoiding-target-x gl-threat-target-pos-x c: 1)
                ;(up-modify-goal gl-avoiding-target-x g:+ gl-avoiding-unit-x)
                ;(up-modify-goal gl-avoiding-target-y g:+ gl-avoiding-unit-y)
                (up-target-point gl-avoiding-target-x action-move -1 stance-no-attack)
                ;(up-chat-data-to-all "gl-enemy-tc-remote-total: %d" g: gl-enemy-tc-remote-total)
                ;(up-send-flare gl-avoiding-target-x)
                (up-send-flare gl-avoiding-target-x)
            )

        (defrule
            (goal gl-threat-target-class-id-for-end 0)
            (goal gl-threat-source-class-id-for-end 0)
            =>
            (up-jump-direct g: gl-threat-source-class-id-for-id)
        )

    (defrule
        (goal gl-threat-target-class-id-for-end 0)
        =>
        (up-jump-direct g: gl-threat-target-class-id-for-id)
    )


(defrule
    (goal gl-avoid-attack-player-id-for-end 0)
    =>
    (up-jump-direct g: gl-avoid-attack-player-id-for-id)
)
; end for player

; restore focus-player
(defrule
    (true)
    =>
    (up-modify-sn sn-focus-player-number g:= gl-avoid-attack-focus-player-bak)
)