(defrule
    (can-research castle-age)
    =>
    (set-goal gl-researching-castle 1)
    (research castle-age)
    (set-strategic-number sn-food-gatherer-percentage 10)
    (set-strategic-number sn-wood-gatherer-percentage 50)
    (set-strategic-number sn-gold-gatherer-percentage 40)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= castle-age)
    =>
    (set-goal gl-researching-castle 0)
)

(defrule
    (building-type-count-total blacksmith > 0)
    (food-amount >= 600)
    (building-type-count-total market == 0)
    =>
    (build market)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build blacksmith)
    (building-type-count-total blacksmith == 0)
    =>
    (build blacksmith)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build archery-range)
    (building-type-count-total archery-range < 2)
    =>
    (build archery-range)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build archery-range)
    (building-type-count-total archery-range <= 2)
    (building-type-count-total blacksmith >= 1)
    (civilian-population > 40)
    =>
    (build archery-range)
)

(defrule
    (current-age >= castle-age)
    (can-build university)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total university == 0)
    =>
    (build university)
)

(defrule
    (current-age >= castle-age)
    (civilian-population > 40)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total stable == 0)
    (can-build stable)
    =>
    (build stable)
    (set-strategic-number sn-food-gatherer-percentage 20)
    (set-strategic-number sn-wood-gatherer-percentage 45)
    (set-strategic-number sn-gold-gatherer-percentage 35)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build farm)
    (building-type-count-total mining-camp >= 1)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (idle-farm-count <= 1)
    (wood-amount >= 180)
    =>
    (build farm)
)

