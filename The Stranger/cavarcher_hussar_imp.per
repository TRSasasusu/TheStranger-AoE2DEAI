    (can-research ri-blast-furnace)
    =>
    (research ri-blast-furnace)
)

(defrule
    (research-completed ri-heavy-cavalry-archer)
    (building-type-count-total stable < 2)
    (can-build stable)
    =>
    (build stable)
)

(defrule
    (research-completed ri-heavy-cavalry-archer)
    (research-completed ri-chain-barding)
    (can-train scout-cavalry-line)
    =>
    (train scout-cavalry-line)
)

(defrule
    (can-build castle)
    =>
    (build castle)
)

(defrule
    (can-train trebuchet)
    =>
    (train trebuchet)
)

(defrule
    (can-train bombard-cannon-line)
    =>
    (train bombard-cannon-line)
)


(defrule
    (current-age == imperial-age)
    (unit-type-count cavalry-archer-class > 5)
    =>
    (enable-timer t-tactics-timer 180)
    (disable-self)
)
(defrule
    (current-age == imperial-age)
    (up-timer-status t-tactics-timer != timer-running)
    =>
    (enable-timer t-tactics-timer 180)
    (up-modify-sn sn-focus-player-number c: any-enemy)
)