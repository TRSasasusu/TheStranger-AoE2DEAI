(defrule
    (can-research feudal-age)
    (civilian-population > 19)
    =>
    (set-goal gl-researching-feudal 1)
    (research feudal-age)
)

(defrule
    (current-age >= feudal-age)
    =>
    (set-goal gl-researching-feudal 0)
)


(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build farm)
    (building-type-count-total barracks > 0)
    (building-type-count-total stable > 0)
    (idle-farm-count <= 1)
    (wood-amount >= 70)
    =>
    (build farm)
)


(defrule
    (can-research ri-double-bit-axe)
    =>
    (research ri-double-bit-axe)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
)

(defrule
    (current-age == feudal-age)
    (can-build stable)
    (building-type-count-total stable < 1)
    =>
    (build stable)
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (food-amount > 200)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith == 0)
    =>
    (build blacksmith)
)

(defrule
    (current-age == feudal-age)
    (can-build mining-camp)
    (building-type-count-total mining-camp < 1)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith >= 1)
    (food-amount > 300)
    =>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (build mining-camp)
)




(defrule
    (unit-type-count scout-cavalry-line > 2)
    (can-research ri-scale-barding)
    =>
    (research ri-scale-barding)
)

(defrule
    (unit-type-count scout-cavalry-line > 5)
    (can-research ri-forging)
    =>
    (research ri-forging)
)

(defrule
    (unit-type-count scout-cavalry-line > 8)
    (can-research ri-bloodlines)
    =>
    (research ri-bloodlines)
)

(defrule
    (current-age == feudal-age)
    (can-train scout-cavalry-line)
    (unit-type-count scout-cavalry-line < 10)
    =>
    (train scout-cavalry-line)
)