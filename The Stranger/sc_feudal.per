(defrule
    (current-age == feudal-age)
    (can-train scout-cavalry-line)
    (unit-type-count scout-cavalry-line < 5)
    (not(and
        (players-current-age focus-player >= castle-age)
        (and
            (players-current-age-time focus-player >= 120)
            (game-time >= 1140)
        )
    ))
    =>
    (train scout-cavalry-line)
)
