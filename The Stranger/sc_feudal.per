(defrule
    (can-research ri-loom)
    (civilian-population > 18)
    =>
    (research ri-loom)
)

(defrule
    (can-research feudal-age)
    (civilian-population > 18)
    =>
    (set-goal gl-researching-feudal 1)
    (research feudal-age)
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 60)
    (set-strategic-number sn-gold-gatherer-percentage 00)
    (set-strategic-number sn-stone-gatherer-percentage 0)

)

(defrule
    (current-age >= feudal-age)
    =>
    (set-goal gl-researching-feudal 0)
)


(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build farm)
    (building-type-count-total barracks > 0)
    (building-type-count-total stable > 0)
    (idle-farm-count <= 1)
    (wood-amount >= 70)
    =>
    (build farm)
)


(defrule
    (can-research ri-double-bit-axe)
    =>
    (research ri-double-bit-axe)
)

; build barracks in wall
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-build place-point 0 c: barracks)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
    (chat-to-all "building barracks normally!?")
)

; build stable in wall
(defrule
    (current-age == feudal-age)
    (can-build stable)
    (building-type-count-total stable < 1)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (current-age == feudal-age)
    (can-build stable)
    (building-type-count-total stable < 1)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-assign-builders c: stable c: 2)
    (up-build place-point 0 c: stable)
    (set-goal gl-wall-building-pending 1)
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (up-jump-rule 1)
)
(defrule
    (current-age == feudal-age)
    (can-build stable)
    (building-type-count-total stable < 1)
    =>
    (up-assign-builders c: stable c: 2)
    (build stable)
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (chat-to-all "building stable normally!?")
)

; build blacksmith in wall
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (food-amount > 200)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (food-amount > 200)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-build place-point 0 c: blacksmith)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1)
)
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (food-amount > 200)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith == 0)
    =>
    (build blacksmith)
    (chat-to-all "building blacksmith normally!?")
)

(defrule
    (current-age == feudal-age)
    (can-build mining-camp)
    (building-type-count-total mining-camp < 1)
    (building-type-count-total stable >= 1)
    (building-type-count-total blacksmith >= 1)
    (food-amount > 300)
    =>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (build mining-camp)
)




(defrule
    (unit-type-count scout-cavalry-line > 2)
    (can-research ri-scale-barding)
    =>
    (research ri-scale-barding)
)

(defrule
    (unit-type-count scout-cavalry-line > 5)
    (can-research ri-forging)
    =>
    (research ri-forging)
)

(defrule
    (unit-type-count scout-cavalry-line > 8)
    (can-research ri-bloodlines)
    =>
    (research ri-bloodlines)
)



(defrule ; at first, go to the pocket
    (game-time < 1200)
    =>
    (up-modify-sn sn-focus-player-number g:= gl-my-pocket-enemy)
    (up-chat-data-to-all "im targeting %d" g: gl-my-pocket-enemy)
    ;(up-modify-sn sn-focus-player-number g:= gl-next-closest-enemy)
    ;(up-chat-data-to-all "im targeting %d" g: gl-next-closest-enemy)
)

