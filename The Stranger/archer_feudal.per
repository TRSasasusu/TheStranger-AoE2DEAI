(defrule
    (can-research ri-loom)
    (or
        (civilian-population > 18)
        (civ-selected mayan)
    )
    =>
    (research ri-loom)
)

(defrule
    (can-research feudal-age)
    (civilian-population > 18)
    =>
    (set-goal gl-researching-feudal 1)
    (research feudal-age)
    (set-strategic-number sn-food-gatherer-percentage 20)
    (set-strategic-number sn-wood-gatherer-percentage 80)
    (set-strategic-number sn-gold-gatherer-percentage 00)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    =>
    (set-goal gl-researching-feudal 0)
)


(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build farm)
    (building-type-count-total barracks > 0)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total mining-camp >= 1)
    (idle-farm-count <= 1)
    (wood-amount >= 110)
    =>
    (build farm)
)


(defrule
    (can-research ri-double-bit-axe)
    =>
    (research ri-double-bit-axe)
)

; build barrack in wall
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-build place-point 0 c: barracks)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
    (chat-to-all "building barracks normally!?")
)

; build archery-range in wall
(defrule
    (current-age == feudal-age)
    (can-build archery-range)
    (building-type-count-total archery-range < 2)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (current-age == feudal-age)
    (can-build archery-range)
    (building-type-count-total archery-range < 2)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-build place-point 0 c: archery-range)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1)
)
(defrule
    (current-age == feudal-age)
    (can-build archery-range)
    (building-type-count-total archery-range < 2)
    =>
    (build archery-range)
    (chat-to-all "building archery range normally!?")
)

; build blacksmith in wall
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range < 4)
    =>
    (set-goal gl-wall-building-pending 1)
    (set-goal gl-wall-building-range 5)
    (up-jump-rule 2)
)
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith == 0)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    (up-compare-goal gl-wall-building-range >= 5)
    =>
    (up-set-target-point gl-wall-building-pos-x)
    (up-build place-point 0 c: blacksmith)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1)
)
(defrule
    (current-age >= feudal-age)
    (can-build blacksmith)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith == 0)
    =>
    (build blacksmith)
    (chat-to-all "building blacksmith normally!?")
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (can-build mining-camp)
    (building-type-count-total mining-camp < 1)
    =>
    (set-strategic-number sn-food-gatherer-percentage 20)
    (set-strategic-number sn-wood-gatherer-percentage 60)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (build mining-camp)
)

(defrule
    (current-age == feudal-age)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    =>
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (disable-self)
)

(defrule
    (current-age == feudal-age)
    (civilian-population > 30)
    =>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (disable-self)
)

