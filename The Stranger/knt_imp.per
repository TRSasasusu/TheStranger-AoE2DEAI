;    (can-research ri-padded-archer-armor)
;    =>
;    (research ri-padded-archer-armor)
;)

(defrule
    (current-age == imperial-age)
    (can-train cav-line)
    =>
    (train cav-line)
)

(defrule
    (current-age == imperial-age)
    (or
        (civilian-population > 75)
        (gold-amount < 400)
    )
    (can-train scout-cavalry-line)
    =>
    (train scout-cavalry-line)
)