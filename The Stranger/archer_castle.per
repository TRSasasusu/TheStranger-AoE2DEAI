(defrule
    (can-research castle-age)
    =>
    (set-goal gl-researching-castle 1)
    (research castle-age)
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-goal gl-trade-stop 1)
)

(defrule
    (current-age >= castle-age)
    =>
    (set-goal gl-researching-castle 0)
)

(defrule
    (building-type-count-total blacksmith > 0)
    (food-amount >= 600)
    (building-type-count-total market == 0)
    =>
    (build market)
)

;(defconst t-)
(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-build archery-range)
    (building-type-count-total archery-range <= 2)
    (building-type-count-total blacksmith >= 1)
    =>
    (build archery-range)
)

(defrule
    (current-age >= castle-age)
    (can-build university)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total university == 0)
    =>
    (build university)
)

(defrule
    (current-age >= castle-age)
    (can-build siege-workshop)
    (building-type-count-total archery-range >= 2)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total siege-workshop == 0)
    =>
    (build siege-workshop)
)

(defrule
    (unit-type-count archer-line > 0)
    (can-research ri-bodkin-arrow)
    =>
    (research ri-bodkin-arrow)
)

(defrule
    (unit-type-count archer-line > 0)
    (can-research ri-crossbow)
    =>
    (research ri-crossbow)
)

(defrule
    (research-completed ri-bodkin-arrow)
    (research-completed ri-crossbow)
    =>
    (set-strategic-number sn-food-gatherer-percentage 20)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 45)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-goal gl-attack-stop 0)
    (disable-self)
)

(defrule
    (can-research ri-bow-saw)
    =>
    (research ri-bow-saw)
)

(defrule
    (or
        (goal gl-researching-castle 1)
        (current-age >= castle-age)
    )
    (can-research ri-horse-collar)
    =>
    (research ri-horse-collar)
)

(defrule
    (unit-type-count archer-line > 2)
    (can-research ri-ballistics)
    =>
    (research ri-ballistics)
)

(defrule
    (unit-type-count archer-line > 10)
    (can-research ri-thumb-ring)
    =>
    (research ri-thumb-ring)
)

;(defrule
;    (unit-type-count archer-line > 10)
;    (can-research ri-padded-archer-armor)
;    =>
;    (research ri-padded-archer-armor)
;)

(defrule
    (current-age >= castle-age)
    (civilian-population > 45)
    =>
    (set-strategic-number sn-food-gatherer-percentage 25)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 45)
    (set-strategic-number sn-stone-gatherer-percentage 5)
    (disable-self)
)

(defrule
    (can-build castle)
    =>
    (up-assign-builders c: castle c: 10)
    (build castle)
)

(defrule
    (current-age == castle-age)
    (can-train archer-line)
    =>
    (train archer-line)
)

(defrule
    (current-age == castle-age)
    (can-train mangonel-line)
    (up-object-type-count c: archer-line >= 10)
    (or
        (research-completed ri-ballistics)
        (unit-type-count mangonel-line <= 2)
    )
    =>
    (train mangonel-line)
)

(defrule
    (unit-type-count mangonel-line >= 2)
    =>
    (set-goal gl-attack-only-attack-move-whole 1)
    (set-goal gl-trade-stop 0)
)

(defrule
    (current-age >= castle-age)
    (game-time > 2100)
    =>
    (set-goal gl-trade-stop 0)
)

(defrule
    (current-age == castle-age)
    =>
    (up-full-reset-search)
    (up-filter-status c: status-ready c: list-active)
    (up-find-status-remote c: castle c: 1)
    ;(up-find-remote c: castle c: 1)
    (up-get-search-state gl-tmp-local-total)
    ;(players-building-type-count focus-player castle >= 1) ; it includes not only ready but also under construction
)
(defrule
    (current-age == castle-age)
    (up-compare-goal gl-tmp-remote-total > 0)
    =>
    (up-modify-sn sn-focus-player-number g:= gl-next-closest-enemy)
)