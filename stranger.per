; ========================================
; Tower Rush AI - 修正版9（軍兵塔ラッシュ）
; ファイル名: tower_rush.per
; ========================================

; ===== 定数定義 =====
(defconst gl-tower-rush-mode 40)
(defconst gl-houses-built 41)
(defconst gl-loom-researched 42)
(defconst gl-military-sent 43)
(defconst min-stone-amount 125)

; ===== 初期設定 =====
(defrule
    (true)
=>
    (set-strategic-number sn-enable-new-building-system 1)
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-percent-civilian-builders 10)
    (set-strategic-number sn-percent-civilian-gatherers 90)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 1)
    (set-strategic-number sn-maximum-explore-group-size 1)
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-strategic-number sn-enable-offensive-priority 1)
    
    ; イノシシ誘導の設定
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-number-hunters 4)
    (set-strategic-number sn-food-dropsite-distance 4)
    
    ; 軍事ユニットの攻撃設定
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-percent-attack-boats 0)
    (set-strategic-number sn-task-ungrouped-soldiers 1)
    (set-strategic-number sn-group-commander-selection-method 1)
    
    (set-goal gl-houses-built 0)
    (set-goal gl-loom-researched 0)
    (set-goal gl-military-sent 0)
    (disable-self)
)

; ===== 機織りの研究（暗黒の時代早期） =====
(defrule
    (current-age == dark-age)
    (goal gl-loom-researched 0)
    (can-research ri-loom)
=>
    (research ri-loom)
    (set-goal gl-loom-researched 1)
    (chat-to-all "機織りを研究")
    (disable-self)
)

; ===== ゲーム開始：最初の家2軒を優先建設 =====
(defrule
    (goal gl-houses-built 0)
    (building-type-count-total house < 2)
    (can-build house)
=>
    (build house)
)

; ===== 家2軒完成後の切り替え =====
(defrule
    (building-type-count-total house >= 2)
    (goal gl-houses-built 0)
=>
    (set-goal gl-houses-built 1)
    (chat-to-all "初期家建設完了")
    (disable-self)
)

; ===== 通常の家建設 =====
(defrule
    (goal gl-houses-built 1)
    (housing-headroom < 3)
    (population-headroom < 3)
    (can-build house)
=>
    (build house)
)

; ===== 暗黒の時代：町の人訓練 =====
(defrule
    (current-age == dark-age)
    (population < 22)
    (can-train villager)
=>
    (train villager)
)

; ===== 暗黒の時代：伐採所 =====
(defrule
    (current-age == dark-age)
    (building-type-count-total house >= 2)
    (building-type-count-total lumber-camp < 2)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

; ===== 暗黒の時代：粉ひき所 =====
(defrule
    (current-age == dark-age)
    (building-type-count-total house >= 2)
    (building-type-count-total mill < 1)
    (can-build mill)
=>
    (build mill)
)

; ===== 領主の時代へ進化 =====
(defrule
    (current-age == dark-age)
    (population >= 21)
    (goal gl-loom-researched 1)
    (can-research feudal-age)
=>
    (research feudal-age)
    (chat-to-all "領主の時代へ進化中")
)

; ===== 領主到達：石採掘開始 =====
(defrule
    (current-age == feudal-age)
    (goal gl-tower-rush-mode 0)
=>
    (set-goal gl-tower-rush-mode 1)
    (set-strategic-number sn-stone-gatherer-percentage 25)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (chat-to-all "軍兵塔ラッシュを開始します")
    (disable-self)
)

; ===== 鉱山キャンプ建設 =====
(defrule
    (current-age >= feudal-age)
    (building-type-count-total mining-camp < 1)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; ===== 兵舎の建設（優先） =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
    (chat-to-all "兵舎建設")
)

; ===== 鍛冶場の建設 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total barracks >= 1)
    (building-type-count-total blacksmith < 1)
    (can-build blacksmith)
=>
    (build blacksmith)
)

; ===== 矢羽根の研究 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total blacksmith >= 1)
    (can-research ri-fletching)
=>
    (research ri-fletching)
    (chat-to-all "矢羽根を研究")
)

; ===== 民兵の研究 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total barracks >= 1)
    (can-research ri-man-at-arms)
=>
    (research ri-man-at-arms)
    (chat-to-all "民兵を研究")
)

; ===== 前線建築者の派遣開始 =====
(defrule
    (current-age == feudal-age)
    (goal gl-tower-rush-mode 1)
    (stone-amount >= min-stone-amount)
    (can-build watch-tower)
=>
    (set-strategic-number sn-number-forward-builders 3)
    (set-goal gl-tower-rush-mode 2)
    (chat-to-all "前線タワー建設開始")
    (disable-self)
)

; ===== 前線タワー建設 =====
(defrule
    (current-age == feudal-age)
    (stone-amount >= 125)
    (building-type-count-total watch-tower < 6)
=>
    (build-forward watch-tower)
)

; ===== 継続的な町の人訓練 =====
(defrule
    (current-age >= feudal-age)
    (unit-type-count-total villager < 35)
    (can-train villager)
=>
    (train villager)
)

; ===== 民兵/軍兵の大量生産 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total barracks >= 1)
    (unit-type-count militia-line < 15)
    (can-train militia-line)
=>
    (train militia-line)
)

; ===== タワー建設後に軍兵を前線へ派遣 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total watch-tower >= 1)
    (unit-type-count militia-line >= 5)
    (goal gl-military-sent 0)
=>
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-minimum-attack-group-size 5)
    (set-strategic-number sn-maximum-attack-group-size 20)
    (set-strategic-number sn-attack-group-gather-spacing 3)
    (set-goal gl-military-sent 1)
    (chat-to-all "軍兵を前線へ派遣")
    (disable-self)
)

; ===== 攻撃グループの編成と送り込み =====
(defrule
    (current-age == feudal-age)
    (unit-type-count militia-line >= 8)
    (goal gl-military-sent 1)
=>
    (attack-now)
)

; ===== 槍兵も生産（対騎兵用） =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total watch-tower >= 1)
    (unit-type-count spearman-line < 8)
    (can-train spearman-line)
=>
    (train spearman-line)
)

; ===== 弓兵育成所の建設 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total archery-range < 1)
    (wood-amount >= 175)
    (can-build archery-range)
=>
    (build archery-range)
)

; ===== 弓兵生産 =====
(defrule
    (current-age == feudal-age)
    (building-type-count-total archery-range >= 1)
    (unit-type-count archer-line < 10)
    (can-train archer-line)
=>
    (train archer-line)
)

; ===== 追加の家建設 =====
(defrule
    (goal gl-houses-built 1)
    (housing-headroom < 5)
    (can-build house)
=>
    (build house)
)

; ===== 石不足時の採掘強化 =====
(defrule
    (current-age == feudal-age)
    (stone-amount < 300)
    (strategic-number sn-stone-gatherer-percentage < 30)
=>
    (set-strategic-number sn-stone-gatherer-percentage 30)
)

; ===== 金採掘の強化（軍兵生産のため） =====
(defrule
    (current-age == feudal-age)
    (gold-amount < 300)
    (unit-type-count militia-line >= 5)
=>
    (set-strategic-number sn-gold-gatherer-percentage 15)
)

; ===== 城主の時代へ =====
(defrule
    (current-age == feudal-age)
    (population >= 35)
    (can-research castle-age)
=>
    (research castle-age)
)
