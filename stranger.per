(defconst gl-far-food-check 10)
(defconst gl-researching-feudal 11)
(defconst gl-tmp 41)
(defconst gl-tmp-x 42)
(defconst gl-tmp-y 43)
(defconst action-attack-move 19)


(defrule
    (true)
    =>
    (chat-to-all "Hi, I'm the Stranger!")
    (disable-self)
)


(defrule
	(true)
=>
	(set-strategic-number sn-cap-civilian-builders 200)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-enable-offensive-priority 1)
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-maximum-fish-boat-drop-distance 30)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-hunt-drop-distance 30)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-scale-minimum-attack-group-size 0)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
    ;(set-strategic-number sn-attack-intelligence 1)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-gate-type-for-wall 1)	;only needs to be set to 1 in RoR
	(set-strategic-number sn-zero-priority-distance 255)
	(set-strategic-number sn-dropsite-separation-distance 3)
	(disable-self)
)

(defrule
    (true)
    =>
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (disable-self)
)

;********ゴール初期化******
(defrule
    (true)
    =>
    (set-goal gl-far-food-check 0)
    (set-goal gl-researching-feudal 0)
    (disable-self)
)

(defrule
    (can-research ri-loom)
    =>
    (research ri-loom)
)

(defrule
    (can-research feudal-age)
    (civilian-population > 19)
    =>
    (set-goal gl-researching-feudal 1)
    (research feudal-age)
)

(defrule
    (current-age >= feudal-age)
    =>
    (set-goal gl-researching-feudal 0)
)


(defrule
    (true)
    =>
    (train villager)
)

(defrule
    (can-build house)
    (housing-headroom < 3)
    (population-headroom > 0)
    =>
    (build house)
)

(defrule
    (civilian-population > 6)
    (can-build lumber-camp)
    (building-type-count-total lumber-camp == 0)
    =>
    (build lumber-camp)
    (set-strategic-number sn-food-gatherer-percentage 80)
    (set-strategic-number sn-wood-gatherer-percentage 20)
)

(defrule
    (civilian-population > 11)
    (can-build mill)
    (building-type-count-total mill == 0)
    =>
    (build mill)
)

(defrule
    (current-age >= dark-age)
    (dropsite-min-distance food > 12)
=>
    (set-goal gl-far-food-check 1)
)


;*********畑*********

(defrule
    (current-age == dark-age)
    (goal gl-far-food-check 1)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build farm)
    (building-type-count-total barracks > 0)
    (building-type-count-total mining-camp >= 2)
    (wood-amount >= 100)
    =>
    (build farm)
)



;*********畑 (end)*********

(defrule
    (can-research ri-double-bit-axe)
    =>
    (research ri-double-bit-axe)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (can-build mining-camp)
    (building-type-count-total mining-camp < 1)
    =>
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 60)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (build mining-camp)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (can-build mining-camp)
    (building-type-count-total mining-camp < 2)
    (building-type-count-total barracks >= 1)
    =>
    (build mining-camp)
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 50)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)


(defconst t-scout-timer 21)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    =>
    (enable-timer t-scout-timer 120)
    (up-send-scout group-type-land-explore scout-enemy)
    (disable-self)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (up-send-scout group-type-land-explore scout-opposite)
    (disable-self)
)

(defrule
    (building-type-count-total blacksmith == 0)
    (building-type-count-total barracks > 0)
    (can-build blacksmith)
    =>
    (build blacksmith)
)

(defrule
    (building-type-count tower-class > 0)
    (can-research ri-fletching)
    =>
    (research ri-fletching)
)

(defrule
    (unit-type-count militiaman-line > 3)
    (can-research ri-scale-mail)
    =>
    (research ri-scale-mail)
)

(defrule
    (unit-type-count militiaman-line > 6)
    (can-research ri-forging)
    =>
    (research ri-forging)
)

(defrule
    (unit-type-count militiaman-line > 8)
    (can-research ri-arson)
    =>
    (research ri-arson)
)


(defconst gl-closest-enemy 20)
(defrule
    (true)
    =>
    (up-find-player enemy find-closest gl-closest-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
    ;(up-chat-data-to-all "set focus player: %d" g: gl-closest-enemy)
)


;**********TR**********
(defrule
    (current-age == feudal-age)
    (can-build watch-tower)
    (unit-type-count militiaman-line > 2)
    =>
    (build-forward watch-tower)
)

;(defrule
;    (can-build watch-tower)
;    (unit-type-count militiaman-line > 2)
;    =>
;    (chat-to-all "I would like to build a tower")
;    ;(up-set-placement-data target-player lumber-camp c: 8)
;    (up-set-placement-data any-enemy lumber-camp c: -4) ; this command is only applicable to ally
;    (up-build place-control 0 c: watch-tower)
;    (chat-to-all "I am proceeding to build a tower now")
;)


(defconst gl-tower-point-x 100)
(defconst gl-tower-point-y 101)
(defconst gl-tower-point-x-start 102)
(defconst gl-tower-point-y-start 103)
(defconst gl-tower-point-x-end 104)
(defconst gl-tower-point-y-end 105)
(defconst gl-tower-wall-now 106)
(defconst gl-tower-local-total 107)
(defconst gl-tower-local-last 108)
(defconst gl-tower-remote-total 109)
(defconst gl-tower-remote-last 110)
(defrule
    (true)
    =>
    (set-goal gl-tower-wall-now 0)
)
(defrule
    (wood-amount >= 16)
    (building-type-count-total tower-class > 0)
    =>
    (up-full-reset-search)
    (up-find-local c: tower-class c: 20)
    (up-get-search-state gl-tower-local-total)
)
(defrule
    (wood-amount >= 16)
    (building-type-count-total tower-class > 0)
    (up-compare-goal gl-tower-local-total > 0)
    =>
    (up-modify-goal gl-tower-local-total c:- 1)
    (up-set-target-object search-local g: gl-tower-local-total)
    (up-get-point position-object gl-tower-point-x)
    (up-chat-data-to-all "target tower: %d" g: gl-tower-local-total)
    (set-goal gl-tower-wall-now 1)
    (up-modify-goal gl-tower-point-x-start g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-start g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-start c:+ 1)
    (up-modify-goal gl-tower-point-y-start c:+ 1)
    (up-modify-goal gl-tower-point-x-end g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-end g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-y-end c:+ 1)
    (up-build-line gl-tower-point-x-start gl-tower-point-x-end c: palisade-wall)
    (up-modify-goal gl-tower-point-x-start g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-start g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-start c:- 1)
    (up-modify-goal gl-tower-point-y-start c:+ 1)
    (up-modify-goal gl-tower-point-x-end g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-end g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-end c:- 1)
    (up-build-line gl-tower-point-x-start gl-tower-point-x-end c: palisade-wall)
)
(defrule
    (goal gl-tower-wall-now 1)
    =>
    (up-modify-goal gl-tower-point-x-start g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-start g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-start c:- 1)
    (up-modify-goal gl-tower-point-y-start c:- 1)
    (up-modify-goal gl-tower-point-x-end g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-end g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-y-end c:- 1)
    (up-build-line gl-tower-point-x-start gl-tower-point-x-end c: palisade-wall)
    (up-modify-goal gl-tower-point-x-start g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-start g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-start c:+ 1)
    (up-modify-goal gl-tower-point-y-start c:- 1)
    (up-modify-goal gl-tower-point-x-end g:= gl-tower-point-x)
    (up-modify-goal gl-tower-point-y-end g:= gl-tower-point-y)
    (up-modify-goal gl-tower-point-x-end c:+ 1)
    (up-build-line gl-tower-point-x-start gl-tower-point-x-end c: palisade-wall)
)
;**********TR (end)**********

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-train militiaman-line)
    =>
    (train militiaman-line)
)

(defrule
    (unit-type-count militiaman-line >= 2)
    (can-research ri-man-at-arms)
    =>
    (research ri-man-at-arms)
)


;(defrule
;    (true)
;    =>
;    (up-set-target-point gl-enemy-tc-x)
;    (up-filter-distance c: 10 c: 100000)
;    (up-find-local c: militiaman-line c: 210)
;    (up-set-attack-stance )
;)

(defconst t-attack-timer 13)
(defconst gl-attack-target-rnd 131)
(defconst gl-attack-target-local-total 132)
(defconst gl-attack-target-local-last 133)
(defconst gl-attack-target-remote-total 134)
(defconst gl-attack-target-remote-last 135)
(defconst gl-attack-target-x 136)
(defconst gl-attack-target-y 137)
(defrule
    (true)
    =>
    (set-goal gl-attack-target-rnd 0)
    (set-goal gl-attack-target-local-total 0)
)
;(defrule
;    (unit-type-count militiaman-line >= 2)
;    (up-timer-status t-attack-timer != timer-running)
;    =>
;    (up-set-offense-priority c: lumber-camp c: 1)
;    (up-set-offense-priority c: mill c: 2)
;    (up-set-offense-priority c: mining-camp c: 3)
;    (up-set-offense-priority c: town-center c: 4)
;    (set-strategic-number sn-percent-attack-soldiers 100)
;    (set-strategic-number sn-percent-attack-boats 100)
;    (attack-now)
;    (enable-timer t-attack-timer 60)
;    (chat-to-all "start attacking!")
;    (generate-random-number 10)
;    (up-get-fact random-number 0 gl-attack-go-deep)
;    ;(up-chat-data-to-all "start attacking!")
;)
(defrule
    (unit-type-count militiaman-line >= 2)
    (up-timer-status t-attack-timer != timer-running)
    =>
    (up-full-reset-search)
    (generate-random-number 25);25
    (up-get-fact random-number 0 gl-attack-target-rnd)
    (up-chat-data-to-all "gl-attack-target-rnd: %d" g: gl-attack-target-rnd)
    (enable-timer t-attack-timer 60)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 5)
    =>
    (up-find-remote c: lumber-camp c: 5)
    (up-get-search-state gl-attack-target-local-total)
    (chat-to-all "try attacking to lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 5)
    (goal gl-attack-target-remote-total 0)
    =>
    (set-goal gl-attack-target-rnd 5)
    (chat-to-all "attacking to NOT lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 5)
    (up-compare-goal gl-attack-target-rnd < 8)
    =>
    (up-find-remote c: mill c: 5)
    (up-get-search-state gl-attack-target-local-total)
    (chat-to-all "try attacking to lumber-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 5)
    (up-compare-goal gl-attack-target-rnd < 8)
    (goal gl-attack-target-remote-total 0)
    =>
    (set-goal gl-attack-target-rnd 8)
    (chat-to-all "attacking to NOT mill")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 8)
    (up-compare-goal gl-attack-target-rnd < 11)
    =>
    (up-find-remote c: mining-camp c: 5)
    (up-get-search-state gl-attack-target-local-total)
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 8)
    (up-compare-goal gl-attack-target-rnd < 11)
    (goal gl-attack-target-remote-total 0)
    =>
    (set-goal gl-attack-target-rnd 11)
    (chat-to-all "attacking to NOT mining-camp")
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 11)
    (up-compare-goal gl-attack-target-rnd < 22)
    =>
    (up-find-remote c: town-center c: 5)
    (up-get-search-state gl-attack-target-local-total)
)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 11)
    (up-compare-goal gl-attack-target-rnd < 22)
    (goal gl-attack-target-remote-total 0)
    =>
    (set-goal gl-attack-target-rnd 22)
    (chat-to-all "attacking to NOT town-center or deep")
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 5)
    =>
    (generate-random-number 100)
    (up-get-fact random-number 0 gl-tmp)
    (up-chat-data-to-all "gl-attack-target-rnd: %d" g: gl-attack-target-rnd)
    (up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp c:- 1)
    (up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp g:* gl-attack-target-remote-total)
    (up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-modify-goal gl-tmp c:z/ 100)
    (up-chat-data-to-all "gl-tmp: %d" g: gl-tmp)
    (up-set-target-object search-remote g: gl-tmp)
    (up-target-objects 1 action-default -1 stance-aggressive)
    (up-get-point position-object gl-tmp-x)
    (up-copy-point gl-attack-target-x gl-tmp-x)
)

(defconst gl-enemy-tc-x 154)
(defconst gl-enemy-tc-y 155)
(defconst gl-position-self-x 162)
(defconst gl-position-self-y 163)
(defconst gl-deep-point-x 164)
(defconst gl-deep-point-y 165)
(defconst gl-self-to-enemy-dist 166)
(defrule
    (up-compare-goal gl-attack-target-rnd >= 13)
    (up-compare-goal gl-attack-target-rnd < 22)
    =>
    ;(generate-random-number 100)
    ;(up-get-fact random-number 0 gl-tmp)
    ;(up-modify-goal gl-tmp c:- 1)
    ;(up-modify-goal gl-tmp g:* gl-attack-target-remote-total)
    ;(up-modify-goal gl-tmp c:z/ 100)
    ;(up-set-target-object search-remote g: gl-tmp)
    (up-get-point position-object gl-enemy-tc-x)
    (up-full-reset-search)
    (up-find-local c: militiaman-line c: 8)
    (up-get-point position-self gl-position-self-x)
    (up-send-flare gl-position-self-x)
    (up-copy-point gl-deep-point-x gl-enemy-tc-x)
    ;(up-send-flare gl-deep-point-x)
    ;(up-add-point gl-deep-point-x gl-position-self-x c:- 1)
    (up-modify-goal gl-deep-point-x g:- gl-position-self-x)
    (up-modify-goal gl-deep-point-y g:- gl-position-self-y)
    ;(up-send-flare gl-deep-point-x)
    (up-get-point-distance gl-position-self-x gl-enemy-tc-x gl-self-to-enemy-dist)
    (up-modify-goal gl-self-to-enemy-dist c:/ 2)
    (up-modify-goal gl-deep-point-x g:/ gl-self-to-enemy-dist)
    (up-modify-goal gl-deep-point-y g:/ gl-self-to-enemy-dist)
    (up-modify-goal gl-deep-point-x c:* 10)
    (up-modify-goal gl-deep-point-y c:* 10)
    (up-add-point gl-deep-point-x gl-enemy-tc-x c: 1)
    ;(up-send-flare gl-deep-point-x)
    (generate-random-number 30)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 15)
    (up-modify-goal gl-deep-point-x g:+ gl-tmp)
    (generate-random-number 30)
    (up-get-fact random-number 0 gl-tmp)
    (up-modify-goal gl-tmp c:- 15)
    (up-modify-goal gl-deep-point-y g:+ gl-tmp)
    (up-copy-point gl-attack-target-x gl-deep-point-x)
    ;(up-target-point gl-deep-point-x action-default -1 stance-stand-ground)
    ;(chat-to-all "try going to deep")
    ;(up-send-flare gl-deep-point-x)
)
(defrule
    (up-compare-goal gl-attack-target-rnd > 0)
    (up-compare-goal gl-attack-target-rnd < 22)
    =>
    (up-find-local c: militiaman-line c: 220)
    (up-target-point gl-attack-target-x action-attack-move -1 -1)
    (up-send-flare gl-attack-target-x)
)


(defrule
    (up-compare-goal gl-attack-target-rnd >= 22)
    =>
    (up-set-offense-priority c: lumber-camp c: 1)
    (up-set-offense-priority c: mill c: 2)
    (up-set-offense-priority c: mining-camp c: 3)
    (up-set-offense-priority c: town-center c: 4)
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-percent-attack-boats 100)
    (attack-now)
)

;***avoid TC***
(defconst gl-enemy-tc-local-total 150)
(defconst gl-enemy-tc-local-last 151)
(defconst gl-enemy-tc-remote-total 152)
(defconst gl-enemy-tc-remote-last 153)
;(defconst gl-enemy-tc-x 154)
;(defconst gl-enemy-tc-y 155)
(defconst gl-avoiding-unit-x 156)
(defconst gl-avoiding-unit-y 157)
(defconst gl-avoiding-target-x 158)
(defconst gl-avoiding-target-y 159)
(defconst gl-enemy-tc-unit-dist 160)
(defconst gl-enemy-tc-unit-dist-minus 161)
(defrule
    (true)
    =>
    (up-set-attack-stance militiaman-line c: stance-aggressive)
)
(defrule
    ;(unit-type-count militiaman-line < 30)
    (true)
    =>
    (up-full-reset-search)
    (up-find-remote c: town-center c: 10)
    (up-get-search-state gl-enemy-tc-local-total)
    (up-modify-goal gl-enemy-tc-remote-total c:- 1)
    ;(up-chat-data-to-all "enemy tc id: %d" g: gl-enemy-tc-remote-total)
)
(defrule
    (up-compare-goal gl-enemy-tc-remote-total >= 0)
    =>
    (up-set-target-object search-remote g: gl-enemy-tc-remote-total)
    ;(up-chat-data-to-all "enemy tc id: %d" g: gl-enemy-tc-remote-total)
    (up-modify-goal gl-enemy-tc-remote-total c:- 1)
    (up-get-point position-object gl-enemy-tc-x)
    ;(up-send-flare gl-enemy-tc-x)
    (up-set-target-point gl-enemy-tc-x)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 11)
    (up-find-local c: militiaman-line c: 30)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object gl-avoiding-unit-x)
    (up-get-point-distance gl-avoiding-unit-x gl-enemy-tc-x gl-enemy-tc-unit-dist)
    (up-modify-goal gl-avoiding-target-x g:= gl-avoiding-unit-x)
    (up-modify-goal gl-avoiding-target-y g:= gl-avoiding-unit-y)
    (up-modify-goal gl-avoiding-target-x g:- gl-enemy-tc-x)
    (up-modify-goal gl-avoiding-target-y g:- gl-enemy-tc-y)
    (up-modify-goal gl-enemy-tc-unit-dist c:/ 2)
    (up-modify-goal gl-avoiding-target-x g:/ gl-enemy-tc-unit-dist)
    (up-modify-goal gl-avoiding-target-y g:/ gl-enemy-tc-unit-dist)
    (up-modify-goal gl-enemy-tc-unit-dist-minus c:= 8)
    (up-modify-goal gl-enemy-tc-unit-dist-minus g:- gl-enemy-tc-unit-dist)
    (up-modify-goal gl-avoiding-target-x g:* gl-enemy-tc-unit-dist-minus)
    (up-modify-goal gl-avoiding-target-y g:* gl-enemy-tc-unit-dist-minus)
    (up-modify-goal gl-avoiding-target-x g:+ gl-avoiding-unit-x)
    (up-modify-goal gl-avoiding-target-y g:+ gl-avoiding-unit-y)
    (up-target-point gl-avoiding-target-x action-default -1 stance-no-attack)
    (up-jump-rule -1) ; iterate for all enemy (focus player) tc
)
;***avoid TC (end)***


;******************** BOAR HUNTING **************************************

#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
(defrule
	(unit-type-count villager >= 9); 8
	(dropsite-min-distance live-boar <= 32)
	(can-research ri-loom)
=>
	(research ri-loom))

(defrule ; split rule
(or	(dropsite-min-distance live-boar <= -1)
(or	(unit-type-count 216 >= 1); male hunter
(or	(unit-type-count 122 >= 1); female hunter
(or	(unit-type-count villager < 9)
	(up-research-status c: ri-loom != research-complete)))))
=>
	(up-jump-rule 2))

(defrule
;	(timer-triggered tensec)
	(dropsite-min-distance live-boar s:<= sn-maximum-hunt-drop-distance)
; nn	(dropsite-min-distance boar-hunting >= 5); no slain boar left
;(or
; j	(unit-type-count villager >= 9)
;	(unit-type-count 958 <= 0)); living domestic animals ; not working?
;(or	(unit-type-count villager >= 14)
;(or	(food-amount >= 50)
;(or	(up-pending-objects c: villager >= 1)
;	(building-type-count-total farm >= 3))))
=>
	(set-strategic-number sn-enable-boar-hunting 2)
	(set-strategic-number sn-minimum-boar-hunt-group-size 1)
	(set-strategic-number sn-minimum-number-hunters 1)
	(set-strategic-number sn-maximum-food-drop-distance 16) ; "failed" hunt
	(set-strategic-number sn-maximum-hunt-drop-distance 32)
;	(up-retask-gatherers food c: 1)
	(up-request-hunters c: 1)
;	(chat-local-to-self "Trying to start a hunt.")
)
(defrule
	(dropsite-min-distance live-boar <= 32)
	(dropsite-min-distance live-boar >= 0)
	(strategic-number sn-enable-boar-hunting == 2)
	(strategic-number sn-minimum-boar-hunt-group-size == 1)
	(strategic-number sn-minimum-number-hunters == 1)
	(unit-type-count 216 <= 0); male hunter
	(unit-type-count 122 <= 0); female hunter
=>
	(up-retask-gatherers food c: 1)
	(disable-self)); test

(defrule
	(dropsite-min-distance live-boar <= 16)
	(strategic-number sn-enable-boar-hunting >= 1)
	(unit-type-count 216 < 2); male hunter
	(unit-type-count 122 < 2); female hunter
(or	(unit-type-count 216 >= 1); male hunter
	(unit-type-count 122 >= 1)); female hunter
=>
	(set-strategic-number sn-minimum-number-hunters 2)
	(up-request-hunters c: 1)
;	(chat-local-to-self "Requesting a support hunter.")
)
(defrule
	(dropsite-min-distance live-boar <= 10) ; else the risc of a dead vill is still too high
	(dropsite-min-distance live-boar >= 0)
	(unit-type-count 216 <= 2); male hunter
	(unit-type-count 122 <= 2); female hunter
	(strategic-number sn-enable-boar-hunting >= 1)
;(or	(unit-type-count 216 >= 1); at least 1 hunter = the boar is not just standing too close to the mill
;	(unit-type-count 122 >= 1))
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 7)
	(set-strategic-number sn-minimum-number-hunters 7)
	(up-retask-gatherers food c: 1)
	(up-request-hunters c: 6)
;	(chat-local-to-self "Adding more hunters.")
)

(defrule
(or	(dropsite-min-distance live-boar s:> sn-maximum-hunt-drop-distance)
	(and	(dropsite-min-distance live-boar >= 11)
		(dropsite-min-distance boar-hunting <= 10))); eating a boar right now
	(strategic-number sn-minimum-number-hunters > 2)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 1)
	(set-strategic-number sn-minimum-number-hunters 2)
;	(chat-local-to-self "Lowering min-hunters.")
)

(defrule
(or	(dropsite-min-distance live-boar > 32)
	(dropsite-min-distance live-boar <= -1))
(or	(building-type-count-total mill >= 2)
	(unit-type-count villager >= 12))
(or	(unit-type-count villager >= 18)
	(and	(cc-players-unit-type-count 0 48 == 0); no boar on the map
		(cc-players-unit-type-count 0 822 == 0)))
	(strategic-number sn-enable-boar-hunting != 1)
=>
	(set-strategic-number sn-enable-boar-hunting 1); enable hunting of all kinds
	(set-strategic-number sn-minimum-boar-hunt-group-size 2)
	(set-strategic-number sn-minimum-number-hunters 2)
;	(chat-local-to-self "Disabling hunting restrictions.")
)
#end-if
#end-if

;******************** BOAR HUNTING (end) **************************************