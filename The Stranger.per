(defconst gl-far-food-check 50)
(defconst gl-researching-feudal 51)
(defconst gl-researching-castle 52)
(defconst gl-researching-imp 53)
(defconst gl-tmp 41)
(defconst gl-tmp-x 42)
(defconst gl-tmp-y 43)
(defconst gl-tmp2-x 44)
(defconst gl-tmp2-y 45)
(defconst gl-tmp-local-total 46)
(defconst gl-tmp-local-last 47)
(defconst gl-tmp-remote-total 48)
(defconst gl-tmp-remote-last 49)
(defconst action-attack-move 19)
(defconst list-active 0)
(defconst list-inactive 1)
(defconst status-pending 0)
(defconst status-ready 2)
(defconst status-resource 3)
(defconst status-down 4)
(defconst status-gather 5)
(defconst archery-class 900)
(defconst infantry-class 906)
(defconst scout-cavalry-class 947)
(defconst gl-attack-stop 250)
(defconst gl-attack-only-attack-move-whole 251)
(defconst gl-trade-stop 221)
