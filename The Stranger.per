(defconst gl-far-food-check 10)
(defconst gl-researching-feudal 11)
(defconst gl-tmp 41)
(defconst gl-tmp-x 42)
(defconst gl-tmp-y 43)
;(defconst gl-tmp2-x 44)
;(defconst gl-tmp2-y 45)
(defconst action-attack-move 19)


(defrule
    (true)
    =>
    (chat-to-all "Hi, I'm the Stranger!")
    (disable-self)
)


(defrule
	(true)
=>
	(set-strategic-number sn-cap-civilian-builders 200)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-enable-offensive-priority 1)
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-maximum-fish-boat-drop-distance 30)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-hunt-drop-distance 30)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-scale-minimum-attack-group-size 0)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
    ;(set-strategic-number sn-attack-intelligence 1)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-gate-type-for-wall 1)	;only needs to be set to 1 in RoR
	(set-strategic-number sn-zero-priority-distance 255)
	(set-strategic-number sn-dropsite-separation-distance 3)
	(disable-self)
)

(defrule
    (true)
    =>
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (disable-self)
)

;********ゴール初期化******
(defrule
    (true)
    =>
    (set-goal gl-far-food-check 0)
    (set-goal gl-researching-feudal 0)
    (disable-self)
)

(defrule
    (can-research ri-loom)
    =>
    (research ri-loom)
)

(defrule
    (can-research feudal-age)
    (civilian-population > 19)
    =>
    (set-goal gl-researching-feudal 1)
    (research feudal-age)
)

(defrule
    (current-age >= feudal-age)
    =>
    (set-goal gl-researching-feudal 0)
)


(defrule
    (true)
    =>
    (train villager)
)

(defrule
    (can-build house)
    (housing-headroom < 3)
    (population-headroom > 0)
    =>
    (build house)
)

(defrule
    (civilian-population > 6)
    (can-build lumber-camp)
    (building-type-count-total lumber-camp == 0)
    =>
    (build lumber-camp)
    (set-strategic-number sn-food-gatherer-percentage 80)
    (set-strategic-number sn-wood-gatherer-percentage 20)
)

(defrule
    (civilian-population > 11)
    (can-build mill)
    (building-type-count-total mill == 0)
    =>
    (build mill)
)

(defrule
    (current-age >= dark-age)
    (dropsite-min-distance food > 12)
=>
    (set-goal gl-far-food-check 1)
)


;*********畑*********

(defrule
    (current-age == dark-age)
    (goal gl-far-food-check 1)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build farm)
    (building-type-count-total barracks > 0)
    (building-type-count-total mining-camp >= 2)
    (wood-amount >= 100)
    =>
    (build farm)
)



;*********畑 (end)*********

(defrule
    (can-research ri-double-bit-axe)
    =>
    (research ri-double-bit-axe)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-build barracks)
    (building-type-count-total barracks == 0)
    =>
    (build barracks)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (can-build mining-camp)
    (building-type-count-total mining-camp < 1)
    =>
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 60)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (build mining-camp)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (can-build mining-camp)
    (building-type-count-total mining-camp < 2)
    (building-type-count-total barracks >= 1)
    =>
    (build mining-camp)
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 50)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)


(defconst t-scout-timer 21)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    =>
    (enable-timer t-scout-timer 120)
    (up-send-scout group-type-land-explore scout-enemy)
    (disable-self)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (up-send-scout group-type-land-explore scout-opposite)
    (disable-self)
)

(defrule
    (building-type-count-total blacksmith == 0)
    (building-type-count-total barracks > 0)
    (can-build blacksmith)
    =>
    (build blacksmith)
)

(defrule
    (building-type-count tower-class > 0)
    (can-research ri-fletching)
    =>
    (research ri-fletching)
)

(defrule
    (unit-type-count militiaman-line > 3)
    (can-research ri-scale-mail)
    =>
    (research ri-scale-mail)
)

(defrule
    (unit-type-count militiaman-line > 6)
    (can-research ri-forging)
    =>
    (research ri-forging)
)

(defrule
    (unit-type-count militiaman-line > 8)
    (can-research ri-arson)
    =>
    (research ri-arson)
)


(defconst gl-closest-enemy 20)
(defrule
    (true)
    =>
    (up-find-player enemy find-closest gl-closest-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
    ;(up-chat-data-to-all "set focus player: %d" g: gl-closest-enemy)
)

(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age >= feudal-age)
    )
    (can-train militiaman-line)
    =>
    (train militiaman-line)
)

(defrule
    (unit-type-count militiaman-line >= 2)
    (can-research ri-man-at-arms)
    =>
    (research ri-man-at-arms)
)


;(defrule
;    (true)
;    =>
;    (up-set-target-point gl-enemy-tc-x)
;    (up-filter-distance c: 10 c: 100000)
;    (up-find-local c: militiaman-line c: 210)
;    (up-set-attack-stance )
;)

(load "The Stranger/tr")

(load "The Stranger/attack")

(load "The Stranger/avoid_tc")

(load "The Stranger/hd_boar")