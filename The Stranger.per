(defrule
    (true)
    =>
    (chat-to-all "Hi, I'm the Stranger!")
    (disable-self)
)


(defrule
	(true)
=>
	(set-strategic-number sn-cap-civilian-builders 200)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-enable-offensive-priority 1)
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-maximum-fish-boat-drop-distance 30)
	(set-strategic-number sn-maximum-food-drop-distance 20)
	(set-strategic-number sn-maximum-gold-drop-distance 20)
	(set-strategic-number sn-maximum-hunt-drop-distance 30)
	(set-strategic-number sn-maximum-stone-drop-distance 20)
	(set-strategic-number sn-scale-minimum-attack-group-size 0)
	(set-strategic-number sn-task-ungrouped-soldiers 0)
    ;(set-strategic-number sn-attack-intelligence 1)
    (set-strategic-number sn-enable-new-building-system 1)
    ;(set-strategic-number sn-camp-max-distance 200)
    (set-strategic-number sn-retask-gather-amount 5)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-gate-type-for-wall 1)	;only needs to be set to 1 in RoR
	(set-strategic-number sn-zero-priority-distance 255)
	(set-strategic-number sn-dropsite-separation-distance 3)
	(disable-self)
)

(defrule
    (true)
    =>
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (disable-self)
)


(defrule
    (can-build house)
    (housing-headroom < 3)
    (population-headroom > 0)
    (up-pending-objects c: house < 2)

    (goal gl-wall-calculated 1)
    (goal gl-wall-building-pending 0)
    (goal gl-wall-building-unavailable 0)
    (goal gl-wall-start-walling 0)
    =>
    (up-build-line gl-wall-building-pos-x gl-wall-building-pos-x c: house)
    ;(up-set-target-point gl-wall-building-pos-x)
    ;(up-build place-point 0 c: house)
    (set-goal gl-wall-building-pending 1)
    (up-jump-rule 1) ; skip normally building houses
)
(defrule
    (can-build house)
    (housing-headroom < 3)
    (population-headroom > 0)
    (up-pending-objects c: house < 2)
    =>
    (build house)
)


(defrule
    (true)
    =>
    (set-goal gl-researching-feudal 0)
    (set-goal gl-attack-stop 0)
    (set-goal gl-attack-only-attack-move-whole 0)
    (set-goal gl-attack-random 0)
    (set-goal gl-vil-stop-making 0)
    (disable-self)
)


(defconst t-scout-timer 11)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    =>
    (enable-timer t-scout-timer 80)
    (up-send-scout group-type-land-explore scout-flank)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 40)
    (up-send-scout group-type-land-explore scout-opposite)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 40)
    (up-send-scout group-type-land-explore scout-enemy)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 80)
    (up-send-scout group-type-land-explore scout-flank)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 60)
    (up-send-scout group-type-land-explore scout-opposite)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 60)
    (up-send-scout group-type-land-explore scout-enemy)
    (disable-self)
)
(defrule
    (or
        (goal gl-researching-feudal 1)
        (current-age == feudal-age)
    )
    (up-timer-status t-scout-timer != timer-running)
    =>
    (enable-timer t-scout-timer 60)
    (up-send-scout group-type-land-explore scout-flank)
    (disable-self)
)

(defconst gl-closest-enemy 20)
(defconst gl-next-closest-enemy 21)
(defconst gl-my-flank-enemy 80)
(defconst gl-my-pocket-enemy 81)
(defrule
    (true)
    =>
    (up-find-player enemy find-closest gl-my-flank-enemy)
    (up-find-next-player enemy find-closest gl-my-flank-enemy)
    (up-modify-goal gl-my-pocket-enemy g:= gl-my-flank-enemy)
    (up-find-player enemy find-closest gl-my-flank-enemy)
    ;(up-chat-data-to-all "closest: %d" g: gl-closest-enemy)
    ;(up-chat-data-to-all "next closest: %d" g: gl-next-closest-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-my-flank-enemy)
    ;(up-chat-data-to-all "set focus player: %d" g: gl-closest-enemy)
    (disable-self)
)
(defrule
    (true)
    =>
    (up-find-player enemy find-closest gl-closest-enemy)
    (up-find-next-player enemy find-closest gl-closest-enemy)
    (up-modify-goal gl-next-closest-enemy g:= gl-closest-enemy)
    (up-find-player enemy find-closest gl-closest-enemy)
    ;(up-chat-data-to-all "closest: %d" g: gl-closest-enemy)
    ;(up-chat-data-to-all "next closest: %d" g: gl-next-closest-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-closest-enemy)
    ;(up-chat-data-to-all "set focus player: %d" g: gl-closest-enemy)
)


